Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Varxy", "[", 
   RowBox[{"x_", ",", "y_", ",", "r_"}], "]"}], "=", 
  RowBox[{"Simplify", "[", 
   RowBox[{
    RowBox[{"CCxy", "-", 
     RowBox[{
      FractionBox["1", 
       SuperscriptBox["\[Sigma]2", "2"]], 
      RowBox[{"Ccross", ".", 
       RowBox[{"Transpose", "[", "Ccross", "]"}]}]}]}], "/.", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Cxx", "->", "As"}], ",", 
      RowBox[{"Cyy", "->", "As"}], ",", 
      RowBox[{"Cx2", "->", 
       RowBox[{"As", " ", 
        SuperscriptBox["ks", "2"], 
        RowBox[{"Sinc", "[", 
         RowBox[{"ks", " ", "x"}], "]"}]}]}], ",", 
      RowBox[{"Cy2", "->", 
       RowBox[{"As", " ", 
        SuperscriptBox["ks", "2"], 
        RowBox[{"Sinc", "[", 
         RowBox[{"ks", " ", "y"}], "]"}]}]}], ",", 
      RowBox[{"Cxy", "->", 
       RowBox[{"As", " ", 
        RowBox[{"Sinc", "[", 
         RowBox[{"ks", " ", "r"}], "]"}]}]}], ",", 
      RowBox[{
       RowBox[{"1", "/", 
        SuperscriptBox["\[Sigma]2", "2"]}], "->", 
       RowBox[{"1", "/", 
        RowBox[{"(", 
         RowBox[{"As", " ", 
          SuperscriptBox["ks", "4"]}], ")"}]}]}]}], "}"}]}], "]"}]}]], "Input",\

