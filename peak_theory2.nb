 RowBox[{
  RowBox[{
   RowBox[{"Cm", "[", 
    RowBox[{"\[Nu]2_", ",", "k3t_", ",", "Ag_"}], "]"}], "=", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{
      FractionBox["2", "3"], 
      RowBox[{"(", 
       RowBox[{"1", "-", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"1", "+", 
           RowBox[{
