Cell[BoxData[
 RowBox[{
  RowBox[{"nCpt", "[", "Cm_", "]"}], ":=", 
  RowBox[{"NIntegrate", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"npkPT", "[", 
      RowBox[{
       RowBox[{"nu2inCk", "[", 
        RowBox[{"Cm", ",", "k3t"}], "]"}], ",", "k3t"}], "]"}], 
