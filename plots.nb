            SuperscriptBox[
             RowBox[{"\[Sigma]n2", "[", 
              RowBox[{"1", ",", "s2s"}], "]"}], "2"]], 
           FractionBox[
            SuperscriptBox["x", "4"], 
            SuperscriptBox["ks", "4"]], 
           SuperscriptBox[
            RowBox[{"\[Psi]2rint", "[", "x", "]"}], "2"]}], "-", 
