Cell[BoxData[
 RowBox[{
  RowBox[{"xmList", "=", 
   RowBox[{"ParallelTable", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"10", "^", "lnk3t"}], ",", 
       RowBox[{
        RowBox[{"x", "/.", 
         RowBox[{"FindRoot", "[", 
          RowBox[{
           RowBox[{
