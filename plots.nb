          RowBox[{
           RowBox[{
            RowBox[{"Length", "[", "#", "]"}], ">", "NcutM"}], ",", 
           RowBox[{"Exp", "[", 
            RowBox[{
             RowBox[{"Mean", "[", 
              RowBox[{"#", "[", 
               RowBox[{"[", 
                RowBox[{"All", ",", "1"}], "]"}], "]"}], "]"}], "+", 
             FractionBox[
              RowBox[{"Variance", "[", 
               RowBox[{"#", "[", 
                RowBox[{"[", 
                 RowBox[{"All", ",", "1"}], "]"}], "]"}], "]"}], "2"]}], 
            "]"}], ",", "0"}], "]"}], "&"}], "@", 
        RowBox[{"MCbinning", "[", 
