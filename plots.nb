        RowBox[{"\[CapitalPsi]0int", "[", "x", "]"}], "-", 
        RowBox[{
         FractionBox[
          SuperscriptBox[
           RowBox[{"\[Gamma]n", "[", "s2s", "]"}], "2"], 
          RowBox[{"1", "-", 
           SuperscriptBox[
            RowBox[{"\[Gamma]n", "[", "s2s", "]"}], "2"]}]], 
         RowBox[{"(", 
          RowBox[{
           SuperscriptBox[
            RowBox[{"\[Psi]1int", "[", "x", "]"}], "2"], "-", 
           RowBox[{"2", 
            SuperscriptBox[
             RowBox[{"\[Gamma]n", "[", "s2s", "]"}], "4"], 
            RowBox[{"\[Psi]1int", "[", "x", "]"}], 
            RowBox[{"\[Psi]2int", "[", "x", "]"}]}], "+", 
           RowBox[{
            SuperscriptBox[
             RowBox[{"\[Gamma]n", "[", "s2s", "]"}], "6"], 
            SuperscriptBox[
             RowBox[{"\[Psi]2int", "[", "x", "]"}], "2"]}]}], ")"}]}]}], 
       ")"}]}], "/.", 
     RowBox[{"{", 
      RowBox[{"Ag", "->", "As"}], "}"}]}], "]"}]}], ";"}]], "Input",
