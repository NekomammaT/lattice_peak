  RowBox[{
   RowBox[{"Mpk", "[", 
    RowBox[{"nu2_", ",", "As_"}], "]"}], "=", 
   RowBox[{
    RowBox[{
     SuperscriptBox["xm", "2"], 
     RowBox[{"Exp", "[", 
      RowBox[{"2", 
       RowBox[{"Sqrt", "[", "As", "]"}], 
       RowBox[{"Sinc", "[", "xm", "]"}], "nu2"}], "]"}], 
