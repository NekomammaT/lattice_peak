Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"tpf", "[", 
   RowBox[{"x_", ",", "y_", ",", "r_"}], "]"}], "=", 
  RowBox[{
   RowBox[{
    RowBox[{"Varxy", "[", 
     RowBox[{"x", ",", "y", ",", "r"}], "]"}], "[", 
    RowBox[{"[", 
     RowBox[{"1", ",", "2"}], "]"}], "]"}], "+", 
   RowBox[{
    RowBox[{"meanx", "[", "x", "]"}], 
    RowBox[{"meanx", "[", "y", "]"}]}]}]}]], "Input",
 CellChangeTimes->{{3.9984684601411753`*^9, 3.9984684659789963`*^9}, {
  3.9984685023937283`*^9, 3.998468509038497*^9}, {3.9984686196544313`*^9, 
  3.998468629068935*^9}},
 CellLabel->"In[80]:=",ExpressionUUID->"00068fdd-00ed-4915-af8f-52a3e5dbe2d2"],

Cell[BoxData[
 RowBox[{
  FractionBox[
   RowBox[{
    SuperscriptBox["\[Mu]2", "2"], " ", 
    RowBox[{"Sinc", "[", 
     RowBox[{"ks", " ", "x"}], "]"}], " ", 
    RowBox[{"Sinc", "[", 
     RowBox[{"ks", " ", "y"}], "]"}]}], 
   SuperscriptBox["ks", "4"]], "+", 
  RowBox[{"As", " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"Sinc", "[", 
      RowBox[{"ks", " ", "r"}], "]"}], "-", 
     RowBox[{
      RowBox[{"Sinc", "[", 
       RowBox[{"ks", " ", "x"}], "]"}], " ", 
      RowBox[{"Sinc", "[", 
       RowBox[{"ks", " ", "y"}], "]"}]}]}], ")"}]}]}]], "Output",
 CellChangeTimes->{3.998468462981791*^9, 3.998468509598302*^9, 
  3.998468630830803*^9, 3.998469084541319*^9, 3.998469123804*^9},
 CellLabel->"Out[80]=",ExpressionUUID->"6f0cdc8f-7b77-4ff4-9319-04514bee51d7"]
}, Open  ]],

