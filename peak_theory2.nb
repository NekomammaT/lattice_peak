    SubscriptBox["\[PartialD]", "nu2"], 
    RowBox[{"Log", "[", 
     RowBox[{"MPBH", "[", 
      RowBox[{"nu2", ",", "k3t"}], "]"}], "]"}]}]}], ";"}]}], "Input",
