Cell[BoxData[{
 RowBox[{
  RowBox[{"Cdata", "=", 
   RowBox[{"Flatten", "[", 
    RowBox[{"Cpeakdata", "[", 
     RowBox[{"[", 
      RowBox[{"All", ",", "All", ",", "5"}], "]"}], "]"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"CnBins", "=", "20"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"CbinSpec", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Min", "[", "Cdata", "]"}], ",", 
     RowBox[{"Max", "[", "Cdata", "]"}], ",", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Max", "[", "Cdata", "]"}], "-", 
