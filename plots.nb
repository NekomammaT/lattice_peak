4571653f4a75"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"\[Sigma]1", "=", 
   FractionBox[
    RowBox[{"2", "\[Pi]", " ", "npeak"}], "NL"]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Sigma]2", "=", 
   SuperscriptBox["\[Sigma]1", "2"]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Sigma]3", "=", 
   SuperscriptBox["\[Sigma]1", "3"]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Sigma]4", "=", 
   SuperscriptBox["\[Sigma]1", "4"]}], ";"}]}], "Input",
 CellChangeTimes->{{4.002154289627619*^9, 4.0021542979920883`*^9}, {
  4.002160531705282*^9, 4.00216053181039*^9}, {4.0039518983306007`*^9, 
