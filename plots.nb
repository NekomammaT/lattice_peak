Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Delta\[Zeta]", "[", "x_", "]"}], "=", 
   RowBox[{"Sqrt", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"\[Sigma]n2", "[", 
       RowBox[{"0", ",", "s2s"}], "]"}], 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"\[CapitalPsi]0int", "[", "x", "]"}], "-", 
        RowBox[{
         FractionBox[
          SuperscriptBox[
           RowBox[{"\[Gamma]n", "[", "s2s", "]"}], "2"], 
          RowBox[{"1", "-", 
