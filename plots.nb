Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"MPBH", "[", 
    RowBox[{"nu2_", ",", "k3t_"}], "]"}], "=", 
   RowBox[{
    RowBox[{
     SuperscriptBox[
      RowBox[{"xmint", "[", "k3t", "]"}], "2"], 
     SuperscriptBox["E", 
      RowBox[{"2", 
       RowBox[{"Sqrt", "[", "As", "]"}], " ", "nu2", " ", 
       RowBox[{"\[Zeta]x", "[", 
        RowBox[{
         RowBox[{"xmint", "[", "k3t", "]"}], ",", "k3t"}], "]"}]}]], 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Cm", "[", 
         RowBox[{"nu2", ",", "k3t"}], "]"}], "-", "Cth"}], ")"}], 
      "\[Gamma]"]}], "/.", 
    RowBox[{"{", 
     RowBox[{"\[Gamma]", "->", 
      FractionBox["36", "100"]}], 
     RowBox[{"(*", 
      RowBox[{",", 
       RowBox[{"Cth", "->", "0.533"}]}], "*)"}], "}"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"dlnMdnu2", "[", 
    RowBox[{"nu2_", ",", "k3t_"}], "]"}], "=", 
   RowBox[{
    SubscriptBox["\[PartialD]", "nu2"], 
    RowBox[{"Log", "[", 
     RowBox[{"MPBH", "[", 
      RowBox[{"nu2", ",", "k3t"}], "]"}], "]"}]}]}], ";"}]}], "Input",
