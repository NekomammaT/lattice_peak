 RowBox[{
  RowBox[{"xmList", "=", 
   RowBox[{"ParallelTable", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"10", "^", "lnk3t"}], ",", 
       RowBox[{
        RowBox[{"x", "/.", 
         RowBox[{"FindRoot", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"CmCond", "[", 
             RowBox[{"x", ",", 
              RowBox[{"10", "^", "lnk3t"}]}], "]"}], "==", "0"}], ",", 
           RowBox[{"{", 
            RowBox[{"x", ",", 
             RowBox[{"Min", "[", 
              RowBox[{
               FractionBox["1", 
                RowBox[{"2", " ", 
                 RowBox[{"10", "^", "lnk3t"}]}]], ",", "1"}], "]"}]}], "}"}], 
