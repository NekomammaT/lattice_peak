   RowBox[{
    RowBox[{"\[Delta]t", "[", 
     RowBox[{"x", ",", "nu2", ",", "k3t"}], "]"}], "-", 
    RowBox[{
     FractionBox["3", "8"], 
     SuperscriptBox[
      RowBox[{"\[Delta]t", "[", 
