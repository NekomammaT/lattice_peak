   3.994293841160448*^9}, {3.994293937086568*^9, 3.994293940029545*^9}},
 CellLabel->"In[6]:=",ExpressionUUID->"73c5927e-0764-4fbe-a3d1-0911b3a24d3d"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Cm", "[", 
    RowBox[{"nu2_", ",", "As_"}], "]"}], "=", 
   RowBox[{
    RowBox[{
     FractionBox["2", "3"], 
     RowBox[{"(", 
      RowBox[{"1", "-", 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"1", "+", 
          RowBox[{"xm", " ", 
           RowBox[{
            RowBox[{"Sinc", "'"}], "[", "xm", "]"}], 
           RowBox[{"Sqrt", "[", "As", "]"}], "nu2"}]}], ")"}], "2"]}], 
      ")"}]}], "/.", 
    RowBox[{"{", 
     RowBox[{"xm", "->", "2.74"}], "}"}]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.981017421372923*^9, 3.981017454164032*^9}, {
  3.9942936865693903`*^9, 3.994293733457938*^9}, {3.9942938427570333`*^9, 
