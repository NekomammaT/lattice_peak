Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"P1", "[", 
    RowBox[{"nu_", ",", "xi1_", ",", "\[Gamma]_"}], "]"}], "=", 
   RowBox[{
    FractionBox["1", 
     RowBox[{"2", "\[Pi]"}]], 
    FractionBox["1", 
     RowBox[{"Sqrt", "[", 
