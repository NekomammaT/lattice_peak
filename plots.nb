      SuperscriptBox[
       RowBox[{"WRTH", "[", 
        RowBox[{
         SuperscriptBox["E", "lnk"], "x"}], "]"}], "2"]}], "//", "Simplify"}],
     ",", 
    RowBox[{"{", 
