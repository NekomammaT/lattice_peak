Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Cpk", "[", "x_", "]"}], "=", 
   RowBox[{
    RowBox[{
     FractionBox["2", "3"], 
     RowBox[{"(", 
      RowBox[{"1", "-", 
       RowBox[{"(", 
        RowBox[{"1", "+", 
         RowBox[{"x", " ", 
          RowBox[{"Sqrt", "[", "As", "]"}], "\[Nu]2", " ", 
          RowBox[{"\[Zeta]p", "[", 
           RowBox[{"x", ",", "k3tb"}], "]"}]}]}], ")"}]}], ")"}]}], "/.", 
    RowBox[{"{", 
