Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"\[Zeta]t", "[", 
    RowBox[{"x_", ",", "nu2_", ",", "k3t_"}], "]"}], "=", 
   RowBox[{
    RowBox[{
     RowBox[{"Sqrt", "[", 
      RowBox[{"\[Sigma]n2", "[", 
       RowBox[{"0", ",", "s2s"}], "]"}], "]"}], 
     FractionBox[
      RowBox[{
       RowBox[{"\[Gamma]n", "[", "s2s", "]"}], "nu2"}], 
      RowBox[{"1", "-", 
