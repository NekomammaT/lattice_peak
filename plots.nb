  RowBox[{
   RowBox[{"\[CapitalDelta]C", "[", 
    RowBox[{"x_", ",", "nu2_", ",", "k3t_"}], "]"}], "=", 
   RowBox[{"Sqrt", "[", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"1", "-", 
          RowBox[{
           FractionBox["3", "4"], 
           RowBox[{"\[Delta]t", "[", 
            RowBox[{"x", ",", "nu2", ",", "k3t"}], "]"}]}]}], ")"}], "2"], 
       "+", 
       RowBox[{
        FractionBox["9", "32"], 
        RowBox[{"Var\[Delta]", "[", "x", "]"}]}]}], ")"}], 
     RowBox[{"Var\[Delta]", "[", "x", "]"}]}], "]"}]}], ";"}]], "Input",
