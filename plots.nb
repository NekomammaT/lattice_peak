Cell[BoxData[{
 RowBox[{
  RowBox[{"\[Psi]nr", "[", 
   RowBox[{"x_", ",", "n_", ",", "s2_"}], "]"}], ":=", 
  RowBox[{"NIntegrate", "[", 
   RowBox[{
    RowBox[{
     RowBox[{
      FractionBox[
       SuperscriptBox["ks", 
        RowBox[{"2", "n"}]], 
       RowBox[{"\[Sigma]n2", "[", 
        RowBox[{"n", ",", "s2"}], "]"}]], 
      SuperscriptBox["E", 
       RowBox[{"2", "n", " ", "lnk"}]], 
      RowBox[{"calPz", "[", 
       RowBox[{"lnk", ",", "s2"}], "]"}], 
      RowBox[{"WRTH", "[", 
       RowBox[{
        SuperscriptBox["E", "lnk"], "x"}], "]"}]}], "//", "Simplify"}], ",", 
    RowBox[{"{", 
     RowBox[{"lnk", ",", 
      RowBox[{"-", "\[Infinity]"}], ",", "\[Infinity]"}], "}"}], ",", 
    RowBox[{"Method", "->", "\"\<GaussKronrodRule\>\""}], ",", 
    RowBox[{"WorkingPrecision", "->", "30"}]}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Psi]nrr", "[", 
