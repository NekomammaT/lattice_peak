Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"s2m", "=", 
   FractionBox["1", "10"]}], ";", 
  RowBox[{"kpm", "=", 
   FractionBox["\[Pi]", "8"]}], ";", 
  RowBox[{"Asm", "=", 
   FractionBox["1", "200"]}], ";", 
  RowBox[{"Cthm", "=", "0.533`"}], ";", 
  RowBox[{"gamm", "=", "0.36`"}], ";", 
  RowBox[{
   RowBox[{"sig", "[", "n_", "]"}], ":=", 
   SqrtBox[
    RowBox[{
     RowBox[{"Exp", "[", 
      RowBox[{"2", " ", 
       SuperscriptBox["n", "2"], " ", "s2m"}], "]"}], " ", 
     SuperscriptBox["kpm", 
      RowBox[{"2", " ", "n"}]]}]]}], ";", 
  RowBox[{"dl", "=", "0.01`"}], ";", 
  RowBox[{"lk", "=", 
   RowBox[{"Range", "[", 
    RowBox[{
     RowBox[{"-", "2.5`"}], ",", "2.5`", ",", "dl"}], "]"}]}], ";", 
  RowBox[{"Pz", "=", 
   RowBox[{"PDF", "[", 
    RowBox[{
     RowBox[{"NormalDistribution", "[", 
      RowBox[{"0", ",", 
       SqrtBox["s2m"]}], "]"}], ",", "lk"}], "]"}]}], ";", 
  RowBox[{"sq", "=", 
   SqrtBox[
    RowBox[{"Asm", " ", "Pz", " ", "dl"}]]}], ";", 
  RowBox[{"xs", "=", 
   RowBox[{"Range", "[", 
    RowBox[{"0.01`", ",", "12", ",", "0.01`"}], "]"}]}], ";", 
  RowBox[{
   RowBox[{"SincT", "[", "u_", "]"}], ":=", 
   FractionBox[
    RowBox[{"Sin", "[", "u", "]"}], "u"]}], ";", 
  RowBox[{
   RowBox[{"DSinc", "[", "u_", "]"}], ":=", 
   RowBox[{
    FractionBox[
     RowBox[{"Cos", "[", "u", "]"}], "u"], "-", 
    FractionBox[
     RowBox[{"Sin", "[", "u", "]"}], 
     SuperscriptBox["u", "2"]]}]}], ";", 
  RowBox[{"Amat", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"sq", " ", 
      RowBox[{"SincT", "[", 
       RowBox[{
        RowBox[{"Exp", "[", "lk", "]"}], " ", "x"}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "xs"}], "}"}]}], "]"}]}], ";", 
  RowBox[{"Bmat", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"sq", " ", 
      RowBox[{"Exp", "[", "lk", "]"}], " ", "x", " ", 
      RowBox[{"DSinc", "[", 
       RowBox[{
        RowBox[{"Exp", "[", "lk", "]"}], " ", "x"}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "xs"}], "}"}]}], "]"}]}], ";", 
  RowBox[{"vth", "=", 
   RowBox[{
    RowBox[{"-", "1"}], "+", 
    SqrtBox[
     RowBox[{"1", "-", 
      RowBox[{"1.5`", " ", "Cthm"}]}]]}]}], ";", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"Total", "[", 
     SuperscriptBox["sq", "2"], "]"}], ",", "vth"}], "}"}]}]], "Input",
 CellLabel->
  "In[526]:=",ExpressionUUID->"693f424e-b549-47e5-95b2-24d713aa2a8c"],

