 RowBox[{
  RowBox[{
   RowBox[{"f", "[", "x_", "]"}], "=", 
   RowBox[{
    RowBox[{
     FractionBox["1", "2"], "x", 
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox["x", "2"], "-", "3"}], ")"}], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"Erf", "[", 
        RowBox[{
         FractionBox["1", "2"], 
         RowBox[{"Sqrt", "[", 
          FractionBox["5", "2"], "]"}], "x"}], "]"}], "+", 
