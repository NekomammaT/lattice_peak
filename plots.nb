Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"nu2inCk", "[", 
    RowBox[{"Cm_", ",", "k3t_"}], "]"}], "=", 
   FractionBox[
    RowBox[{
     RowBox[{"Sqrt", "[", 
      RowBox[{"1", "-", 
       RowBox[{
        FractionBox["3", "2"], "Cm"}]}], "]"}], "-", "1"}], 
    RowBox[{
     RowBox[{"xmint", "[", "k3t", "]"}], 
     FractionBox[
      SuperscriptBox["\[Sigma]1", "2"], "\[Sigma]2"], 
     RowBox[{"Sqrt", "[", "As", "]"}], 
     RowBox[{"\[Zeta]p", "[", 
      RowBox[{
       RowBox[{"xmint", "[", "k3t", "]"}], ",", "k3t"}], "]"}]}]]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
