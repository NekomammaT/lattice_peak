Cell[BoxData[
 RowBox[{
  RowBox[{"meanx", "[", "r_", "]"}], "=", 
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{"Ccross", " ", 
      FractionBox["1", 
       SuperscriptBox["\[Sigma]2", "2"]], "\[Mu]2"}], ")"}], "[", 
    RowBox[{"[", 
     RowBox[{"1", ",", "1"}], "]"}], "]"}], "/.", 
   RowBox[{"{", 
