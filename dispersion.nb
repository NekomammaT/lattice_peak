Cell[BoxData[{
 RowBox[{
  RowBox[{"P1", "[", 
   RowBox[{"X1_", ",", "X2_"}], "]"}], "=", 
  RowBox[{"Simplify", "[", 
   RowBox[{
    RowBox[{
     FractionBox["1", 
      RowBox[{"Sqrt", "[", 
       RowBox[{
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"2", "\[Pi]"}], ")"}], "2"], " ", 
        RowBox[{"Abs", "[", 
         RowBox[{"Det", "[", "CC", "]"}], "]"}]}], "]"}]], 
     RowBox[{"Exp", "[", 
      RowBox[{
       FractionBox[
        RowBox[{"-", "1"}], "2"], 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"X1", ",", "X2"}], "}"}], ".", 
        RowBox[{"Inverse", "[", "CC", "]"}], ".", 
        RowBox[{"{", 
