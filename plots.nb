       RowBox[{"Dashed", ",", "Black"}], "}"}]}], ",", 
     RowBox[{"FrameLabel", "->", 
      RowBox[{"{", 
       RowBox[{
        SubscriptBox["\[Nu]", "2"], ",", 
        SuperscriptBox[
         SubscriptBox[
          RowBox[{"OverHat", "[", "n", "]"}], "pk"], 
         "\"\<(\!\(\*SubscriptBox[\(\[Nu]\), \(2\)]\))\>\""]}], "}"}]}], ",", 
     
     RowBox[{"PlotRange", "->", 
      RowBox[{"{", 
       RowBox[{
        SuperscriptBox["10", 
         RowBox[{"-", "8"}]], ",", 
        SuperscriptBox["10", 
         RowBox[{"-", "2"}]]}], "}"}]}]}], "]"}], ",", 
   RowBox[{"ListLogPlot", "[", 
