             RowBox[{"(", 
              RowBox[{"1", "-", 
               SuperscriptBox["\[Gamma]3", "2"]}], ")"}]}]], 
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              SuperscriptBox["\[Gamma]3", "2"], 
              RowBox[{"\[Psi]1pint", "[", "x", "]"}]}], "-", 
             RowBox[{
              FractionBox["1", "3"], 
              SuperscriptBox["R3", "2"], 
              FractionBox[
               SuperscriptBox["\[Sigma]2", "2"], 
               SuperscriptBox["\[Sigma]1", "2"]], 
              RowBox[{"\[Psi]2pint", "[", "x", "]"}]}]}], ")"}]}]}], ")"}]}], 
       ";", "\[IndentingNewLine]", 
       RowBox[{"k3tb", "=", 
        RowBox[{
         RowBox[{"Sqrt", "[", 
          FractionBox["\[Sigma]2", "\[Sigma]4"], "]"}], 
         RowBox[{"Sqrt", "[", 
          RowBox[{"-", 
           FractionBox["LapLapb0", "Lapb0"]}], "]"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"bias", "[", "x_", "]"}], ":=", 
        RowBox[{
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{
            RowBox[{"-", 
             FractionBox[
              SuperscriptBox["\[Sigma]1", "2"], 
              SuperscriptBox["\[Sigma]2", "2"]]}], "Lapb0"}], ")"}], 
          RowBox[{"-", "1"}]], 
         RowBox[{"NIntegrate", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Sinc", "[", 
             RowBox[{
              SuperscriptBox["E", "lnk"], "x"}], "]"}], 
            FractionBox["1", 
             RowBox[{"Sqrt", "[", 
              RowBox[{"2", "\[Pi]", " ", "s2b"}], "]"}]], 
            RowBox[{"Exp", "[", 
             FractionBox[
              RowBox[{"-", 
               SuperscriptBox["lnk", "2"]}], 
              RowBox[{"2", "s2b"}]], "]"}], 
            RowBox[{"Sqrt", "[", 
             RowBox[{"calPz", "[", "lnk", "]"}], "]"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"lnk", ",", 
             RowBox[{"-", "\[Infinity]"}], ",", "\[Infinity]"}], "}"}], ",", 
           RowBox[{"Method", "->", "\"\<GaussKronrodRule\>\""}], ",", 
           RowBox[{"WorkingPrecision", "->", "30"}]}], "]"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"bp", "[", "x_", "]"}], ":=", 
        RowBox[{
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{
            RowBox[{"-", 
             FractionBox[
              SuperscriptBox["\[Sigma]1", "2"], 
              SuperscriptBox["\[Sigma]2", "2"]]}], "Lapb0"}], ")"}], 
          RowBox[{"-", "1"}]], 
         RowBox[{"NIntegrate", "[", 
          RowBox[{
           RowBox[{
            SuperscriptBox["E", "lnk"], 
            RowBox[{
             RowBox[{"Sinc", "'"}], "[", 
             RowBox[{
              SuperscriptBox["E", "lnk"], "x"}], "]"}], 
            FractionBox["1", 
             RowBox[{"Sqrt", "[", 
              RowBox[{"2", "\[Pi]", " ", "s2b"}], "]"}]], 
            RowBox[{"Exp", "[", 
             FractionBox[
              RowBox[{"-", 
               SuperscriptBox["lnk", "2"]}], 
              RowBox[{"2", "s2b"}]], "]"}], 
            RowBox[{"Sqrt", "[", 
             RowBox[{"calPz", "[", "lnk", "]"}], "]"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"lnk", ",", 
             RowBox[{"-", "\[Infinity]"}], ",", "\[Infinity]"}], "}"}], ",", 
           RowBox[{"Method", "->", "\"\<GaussKronrodRule\>\""}], ",", 
           RowBox[{"WorkingPrecision", "->", "30"}]}], "]"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"biasList", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"x", ",", 
            RowBox[{"bias", "[", "x", "]"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"x", ",", 
            SuperscriptBox["10", 
             RowBox[{"-", "2"}]], ",", "10", ",", 
            SuperscriptBox["10", 
             RowBox[{"-", "2"}]]}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"bpList", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"x", ",", 
            RowBox[{"bp", "[", "x", "]"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"x", ",", 
            SuperscriptBox["10", 
             RowBox[{"-", "2"}]], ",", "10", ",", 
            SuperscriptBox["10", 
             RowBox[{"-", "2"}]]}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"biasint", "[", "x_", "]"}], "=", 
        RowBox[{
         RowBox[{"Interpolation", "[", "biasList", "]"}], "[", "x", "]"}]}], 
       ";", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"bpint", "[", "x_", "]"}], "=", 
        RowBox[{
         RowBox[{"Interpolation", "[", "bpList", "]"}], "[", "x", "]"}]}], 
       ";", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"Cpk", "[", "x_", "]"}], "=", 
        RowBox[{
         RowBox[{
          FractionBox["2", "3"], 
          RowBox[{"(", 
           RowBox[{"1", "-", 
            SuperscriptBox[
             RowBox[{"(", 
              RowBox[{"1", "+", 
               RowBox[{"x", " ", 
                RowBox[{"Sqrt", "[", "As", "]"}], " ", 
                FractionBox[
                 SuperscriptBox["\[Sigma]1", "2"], "\[Sigma]2"], " ", 
                "\[Nu]2", " ", 
                RowBox[{"\[Zeta]p", "[", 
                 RowBox[{"x", ",", "k3tb"}], "]"}]}]}], ")"}], "2"]}], 
           ")"}]}], "/.", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"As", "->", 
            RowBox[{"5", " ", 
             SuperscriptBox["10", 
              RowBox[{"-", "3"}]]}]}], ",", 
           RowBox[{"\[Nu]2", "->", "8"}]}], "}"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"Cbias", "[", "x_", "]"}], "=", 
        RowBox[{
         RowBox[{
          FractionBox["2", "3"], 
          RowBox[{"(", 
           RowBox[{"1", "-", 
            SuperscriptBox[
             RowBox[{"(", 
              RowBox[{"1", "+", 
               RowBox[{"x", " ", 
                RowBox[{"Sqrt", "[", "As", "]"}], 
                FractionBox[
                 SuperscriptBox["\[Sigma]1", "2"], "\[Sigma]2"], " ", 
                "\[Nu]2", " ", 
                RowBox[{"bpint", "[", "x", "]"}]}]}], ")"}], "2"]}], ")"}]}], 
         "/.", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"As", "->", 
            RowBox[{"5", " ", 
             SuperscriptBox["10", 
              RowBox[{"-", "3"}]]}]}], ",", 
           RowBox[{"\[Nu]2", "->", "8"}]}], "}"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Cpk", "[", "x", "]"}], ",", 
         RowBox[{"Cbias", "[", "x", "]"}]}], "}"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"lnkUV", ",", "0", ",", "1", ",", 
        SuperscriptBox["10", 
         RowBox[{"-", "1"}]]}], "}"}]}], "]"}]}], ";"}], "//", 
  "AbsoluteTiming"}]], "Input",
