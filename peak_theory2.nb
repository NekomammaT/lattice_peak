             RowBox[{"Sqrt", "[", 
              RowBox[{"\[Sigma]n2", "[", 
               RowBox[{"2", ",", "s2s"}], "]"}], "]"}]], " ", "\[Nu]2", " ", 
            RowBox[{"\[Zeta]p", "[", 
             RowBox[{
              RowBox[{"xmint", "[", "k3t", "]"}], ",", "k3t"}], "]"}]}]}], 
          ")"}], "2"]}], ")"}]}], ",", 
     RowBox[{"{", 
