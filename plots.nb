         RowBox[{"[", "1", "]"}], "]"}], "//", "Quiet"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"lnk3t", ",", 
       RowBox[{"-", "2"}], ",", 
       RowBox[{"Log10", "[", "k3tc", "]"}], ",", 
       SuperscriptBox["10", 
