Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"dlnMdmu2", "[", 
    RowBox[{"nu2_", ",", "As_"}], "]"}], "=", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"2", 
       RowBox[{"Sqrt", "[", "As", "]"}], 
       RowBox[{"Sinc", "[", "xm", "]"}]}], "+", 
      RowBox[{
       FractionBox["\[Gamma]", 
        RowBox[{
         RowBox[{"Cm", "[", 
          RowBox[{"nu2", ",", "As"}], "]"}], "-", "Cth"}]], 
       RowBox[{
        SubscriptBox["\[PartialD]", "nu2"], 
        RowBox[{"Cm", "[", 
         RowBox[{"nu2", ",", "As"}], "]"}]}]}]}], "/.", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Cth", "->", "0.533"}], ",", 
       RowBox[{"\[Gamma]", "->", "0.36"}], ",", 
       RowBox[{"xm", "->", "2.74"}]}], "}"}]}], "//", "Simplify"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.981017373769113*^9, 3.9810174059479837`*^9}, {
