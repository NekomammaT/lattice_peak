Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"\[Delta]t", "[", 
    RowBox[{"x_", ",", "nu2_", ",", "k3t_"}], "]"}], "=", 
   RowBox[{
    FractionBox[
     RowBox[{"-", "4"}], "3"], "x", " ", 
    RowBox[{"\[Zeta]tp", "[", 
     RowBox[{"x", ",", "nu2", ",", "k3t"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"calCt", "[", 
    RowBox[{"x_", ",", "nu2_", ",", "k3t_"}], "]"}], "=", 
   RowBox[{
    RowBox[{"\[Delta]t", "[", 
     RowBox[{"x", ",", "nu2", ",", "k3t"}], "]"}], "-", 
    RowBox[{
     FractionBox["3", "8"], 
     SuperscriptBox[
      RowBox[{"\[Delta]t", "[", 
       RowBox[{"x", ",", "nu2", ",", "k3t"}], "]"}], "2"]}]}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{4.001980473643992*^9, 4.001980560831254*^9}, {
  4.0021604322697*^9, 4.00216043239721*^9}},
 CellLabel->
  "In[152]:=",ExpressionUUID->"bb97e833-eb34-44f3-968e-d75e6ba883d5"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"\[Psi]nr", "[", 
   RowBox[{"x_", ",", "n_", ",", "s2_"}], "]"}], ":=", 
  RowBox[{"NIntegrate", "[", 
   RowBox[{
    RowBox[{
     RowBox[{
      FractionBox[
       SuperscriptBox["ks", 
        RowBox[{"2", "n"}]], 
       RowBox[{"\[Sigma]n2", "[", 
        RowBox[{"n", ",", "s2"}], "]"}]], 
      SuperscriptBox["E", 
       RowBox[{"2", "n", " ", "lnk"}]], 
      RowBox[{"calPz", "[", 
       RowBox[{"lnk", ",", "s2"}], "]"}], 
      RowBox[{"WRTH", "[", 
       RowBox[{
        SuperscriptBox["E", "lnk"], "x"}], "]"}]}], "//", "Simplify"}], ",", 
    RowBox[{"{", 
     RowBox[{"lnk", ",", 
      RowBox[{"-", "\[Infinity]"}], ",", "\[Infinity]"}], "}"}], ",", 
    RowBox[{"Method", "->", "\"\<GaussKronrodRule\>\""}], ",", 
    RowBox[{"WorkingPrecision", "->", "30"}]}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Psi]nrr", "[", 
   RowBox[{"x_", ",", "n_", ",", "s2_"}], "]"}], ":=", 
  RowBox[{"NIntegrate", "[", 
   RowBox[{
    RowBox[{
     RowBox[{
      FractionBox[
       SuperscriptBox["ks", 
        RowBox[{"2", "n"}]], 
       RowBox[{"\[Sigma]n2", "[", 
        RowBox[{"n", ",", "s2"}], "]"}]], 
      SuperscriptBox["E", 
       RowBox[{"2", "n", " ", "lnk"}]], 
      RowBox[{"calPz", "[", 
       RowBox[{"lnk", ",", "s2"}], "]"}], 
      SuperscriptBox[
       RowBox[{"WRTH", "[", 
        RowBox[{
         SuperscriptBox["E", "lnk"], "x"}], "]"}], "2"]}], "//", "Simplify"}],
     ",", 
    RowBox[{"{", 
     RowBox[{"lnk", ",", 
      RowBox[{"-", "\[Infinity]"}], ",", "\[Infinity]"}], "}"}], ",", 
    RowBox[{"Method", "->", "\"\<GaussKronrodRule\>\""}], ",", 
    RowBox[{"WorkingPrecision", "->", "30"}]}], "]"}]}]}], "Input",
 CellChangeTimes->{{3.998527956451478*^9, 3.998528010862879*^9}, {
