Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"\[Delta]t", "[", 
    RowBox[{"x_", ",", "nu2_", ",", "k3t_"}], "]"}], "=", 
   RowBox[{
    FractionBox[
     RowBox[{"-", "4"}], "3"], "x", " ", 
    RowBox[{"\[Zeta]tp", "[", 
     RowBox[{"x", ",", "nu2", ",", "k3t"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"calCt", "[", 
    RowBox[{"x_", ",", "nu2_", ",", "k3t_"}], "]"}], "=", 
   RowBox[{
    RowBox[{"\[Delta]t", "[", 
     RowBox[{"x", ",", "nu2", ",", "k3t"}], "]"}], "-", 
    RowBox[{
     FractionBox["3", "8"], 
     SuperscriptBox[
      RowBox[{"\[Delta]t", "[", 
       RowBox[{"x", ",", "nu2", ",", "k3t"}], "]"}], "2"]}]}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{4.001980473643992*^9, 4.001980560831254*^9}, {
