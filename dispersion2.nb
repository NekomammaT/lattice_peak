Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"meanx", "[", "r_", "]"}], "=", 
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{"Ccross", " ", 
      FractionBox["1", 
       SuperscriptBox["\[Sigma]2", "2"]], "\[Mu]2"}], ")"}], "[", 
    RowBox[{"[", 
     RowBox[{"1", ",", "1"}], "]"}], "]"}], "/.", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Cx2", "->", 
      RowBox[{"As", " ", 
       SuperscriptBox["ks", "2"], 
       RowBox[{"Sinc", "[", 
        RowBox[{"ks", " ", "r"}], "]"}]}]}], ",", 
     RowBox[{
      RowBox[{"1", "/", 
       SuperscriptBox["\[Sigma]2", "2"]}], "->", 
      RowBox[{"1", "/", 
