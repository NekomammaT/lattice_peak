Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"A", "[", 
    RowBox[{"\[Theta]_", ",", "\[Phi]_", ",", "e_", ",", "p_"}], "]"}], "=", 
   RowBox[{
    RowBox[{"3", "e", 
     RowBox[{"(", 
      RowBox[{"1", "-", 
       RowBox[{
        SuperscriptBox[
         RowBox[{"Sin", "[", "\[Theta]", "]"}], "2"], 
        RowBox[{"(", 
         RowBox[{"1", "+", 
          SuperscriptBox[
           RowBox[{"Sin", "[", "\[Phi]", "]"}], "2"]}], ")"}]}]}], ")"}]}], "+", 
    RowBox[{"p", 
     RowBox[{"(", 
      RowBox[{"1", "-", 
       RowBox[{"3", 
        SuperscriptBox[
         RowBox[{"Sin", "[", "\[Theta]", "]"}], "2"], 
        SuperscriptBox[
         RowBox[{"Cos", "[", "\[Phi]", "]"}], "2"]}]}], ")"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"zeta", "[", 
    RowBox[{
    "r_", ",", "\[Theta]_", ",", "\[Phi]_", ",", "\[Mu]_", ",", "e_", ",", 
     "p_"}], "]"}], "=", 
   RowBox[{
    RowBox[{"\[Mu]", " ", 
     RowBox[{"Sinc", "[", 
      RowBox[{"ks", " ", "r"}], "]"}]}], "+", 
    RowBox[{"\[Mu]", " ", "5", 
     FractionBox[
      RowBox[{"A", "[", 
       RowBox[{"\[Theta]", ",", "\[Phi]", ",", "e", ",", "p"}], "]"}], 
      RowBox[{"2", 
       SuperscriptBox["ks", "3"], 
       SuperscriptBox["r", "3"]}]], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"3", 
        SuperscriptBox["ks", "2"], 
        SuperscriptBox["r", "2"], 
        RowBox[{"Cos", "[", 
         RowBox[{"ks", " ", "r"}], "]"}]}], "+", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           SuperscriptBox["ks", "2"], 
           SuperscriptBox["r", "2"]}], "-", "3"}], ")"}], 
        RowBox[{"Sin", "[", 
         RowBox[{"ks", " ", "r"}], "]"}]}]}], ")"}]}]}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.998554056534254*^9, 3.99855419063868*^9}},
