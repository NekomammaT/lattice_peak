  RowBox[{
   RowBox[{"LogPlot", "[", 
    RowBox[{
     RowBox[{"nnu2PT", "[", "nu2", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"nu2", ",", "0", ",", "6"}], "}"}], ",", 
     RowBox[{"PlotStyle", "->", 
