Cell[BoxData[{
 RowBox[{
  RowBox[{"Lpeak", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Import", "[", 
      RowBox[{"\"\<data/paper/mono/mono_Lpeak_256_16_\>\"", "<>", 
       RowBox[{"ToString", "[", "i", "]"}], "<>", "\"\<.csv\>\""}], "]"}], 
     ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "0", ",", 
       RowBox[{"Nsim", "-", "1"}]}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"nuP", "=", 
   RowBox[{
    RowBox[{"Lpeak", "[", 
     RowBox[{"[", 
      RowBox[{"All", ",", "All", ",", "4"}], "]"}], "]"}], "/", 
    "\[Sigma]2"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"k3P", "=", 
   RowBox[{
    RowBox[{"Lpeak", "[", 
     RowBox[{"[", 
      RowBox[{"All", ",", "All", ",", "5"}], "]"}], "]"}], 
    RowBox[{"Sqrt", "[", 
     RowBox[{"\[Sigma]2", "/", "\[Sigma]4"}], "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"nuk3P", "=", 
