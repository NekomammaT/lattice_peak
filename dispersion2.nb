Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"A", "[", 
    RowBox[{"\[Theta]_", ",", "\[Phi]_", ",", "e_", ",", "p_"}], "]"}], "=", 
   RowBox[{
    RowBox[{"3", "e", 
     RowBox[{"(", 
      RowBox[{"1", "-", 
       RowBox[{
        SuperscriptBox[
         RowBox[{"Sin", "[", "\[Theta]", "]"}], "2"], 
        RowBox[{"(", 
         RowBox[{"1", "+", 
          SuperscriptBox[
           RowBox[{"Sin", "[", "\[Phi]", "]"}], "2"]}], ")"}]}]}], ")"}]}], 
    "+", 
    RowBox[{"p", 
     RowBox[{"(", 
      RowBox[{"1", "-", 
       RowBox[{"3", 
        SuperscriptBox[
         RowBox[{"Sin", "[", "\[Theta]", "]"}], "2"], 
        SuperscriptBox[
         RowBox[{"Cos", "[", "\[Phi]", "]"}], "2"]}]}], ")"}]}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"zeta", "[", 
    RowBox[{
