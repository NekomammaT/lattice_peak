Cell[BoxData[
 RowBox[{
  FractionBox[
   RowBox[{
    SuperscriptBox["\[Mu]2", "2"], " ", 
    RowBox[{"Sinc", "[", 
     RowBox[{"ks", " ", "x"}], "]"}], " ", 
    RowBox[{"Sinc", "[", 
     RowBox[{"ks", " ", "y"}], "]"}]}], 
