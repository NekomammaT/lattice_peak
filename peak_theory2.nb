Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"CmCond", "[", 
    RowBox[{"x_", ",", "k3t_"}], "]"}], "=", 
   RowBox[{
    FractionBox[
     RowBox[{
      RowBox[{"\[Zeta]p", "[", 
       RowBox[{"x", ",", "k3t"}], "]"}], "+", 
      RowBox[{"x", " ", 
       RowBox[{"\[Zeta]pp", "[", 
        RowBox[{"x", ",", "k3t"}], "]"}]}]}], 
     SuperscriptBox["x", "3"]], "/", 
    RowBox[{"(", 
     RowBox[{
      FractionBox[
       SuperscriptBox["\[Sigma]1", "2"], "\[Sigma]2"], "nu2data"}], ")"}]}]}],
   ";"}]], "Input",
