Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"rxy", "[", 
   RowBox[{
   "x_", ",", "y_", ",", "\[Theta]x_", ",", "\[Theta]y_", ",", "\[Phi]x_", 
    ",", "\[Phi]y_"}], "]"}], "=", 
  RowBox[{"Sqrt", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"x", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"Sin", "[", "\[Theta]x", "]"}], 
           RowBox[{"Cos", "[", "\[Phi]x", "]"}]}], ",", 
          RowBox[{
           RowBox[{"Sin", "[", "\[Theta]x", "]"}], 
           RowBox[{"Sin", "[", "\[Phi]x", "]"}]}], ",", 
          RowBox[{"Cos", "[", "\[Theta]x", "]"}]}], "}"}]}], "-", 
       RowBox[{"y", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"Sin", "[", "\[Theta]y", "]"}], 
           RowBox[{"Cos", "[", "\[Phi]y", "]"}]}], ",", 
          RowBox[{
           RowBox[{"Sin", "[", "\[Theta]y", "]"}], 
           RowBox[{"Sin", "[", "\[Phi]y", "]"}]}], ",", 
          RowBox[{"Cos", "[", "\[Theta]y", "]"}]}], "}"}]}]}], ")"}], ".", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"x", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"Sin", "[", "\[Theta]x", "]"}], 
           RowBox[{"Cos", "[", "\[Phi]x", "]"}]}], ",", 
          RowBox[{
           RowBox[{"Sin", "[", "\[Theta]x", "]"}], 
           RowBox[{"Sin", "[", "\[Phi]x", "]"}]}], ",", 
          RowBox[{"Cos", "[", "\[Theta]x", "]"}]}], "}"}]}], "-", 
       RowBox[{"y", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"Sin", "[", "\[Theta]y", "]"}], 
           RowBox[{"Cos", "[", "\[Phi]y", "]"}]}], ",", 
          RowBox[{
           RowBox[{"Sin", "[", "\[Theta]y", "]"}], 
           RowBox[{"Sin", "[", "\[Phi]y", "]"}]}], ",", 
          RowBox[{"Cos", "[", "\[Theta]y", "]"}]}], "}"}]}]}], ")"}]}], "//", 
    "FullSimplify"}], "]"}]}]], "Input",
 CellChangeTimes->{{3.998469402956421*^9, 3.998469434423749*^9}, {
