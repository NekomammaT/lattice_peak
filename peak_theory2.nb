Cell[BoxData[
 RowBox[{
  RowBox[{"nPBH", "[", "M_", "]"}], ":=", 
  RowBox[{"NIntegrate", "[", 
   RowBox[{
    FractionBox[
     RowBox[{"npkPT", "[", 
      RowBox[{
       RowBox[{"nu2int", "[", 
        RowBox[{"M", ",", "k3t"}], "]"}], ",", "k3t", ",", "kpeak"}], "]"}], 
     RowBox[{"Abs", "[", 
      RowBox[{"dlnMdnu2", "[", 
       RowBox[{
        RowBox[{"nu2int", "[", 
         RowBox[{"M", ",", "k3t"}], "]"}], ",", "k3t"}], "]"}], "]"}]], ",", 
    RowBox[{"{", 
     RowBox[{"k3t", ",", 
      SuperscriptBox["10", 
       RowBox[{"-", "2"}]], ",", 
      RowBox[{"k3tMint", "[", "M", "]"}]}], "}"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.9927335884325047`*^9, 3.992733612568367*^9}, {
