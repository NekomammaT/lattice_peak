Cell[BoxData[{
 RowBox[{
  RowBox[{"bias", "[", "x_", "]"}], ":=", 
  RowBox[{
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", 
       FractionBox[
        SuperscriptBox["\[Sigma]1", "2"], 
        SuperscriptBox["\[Sigma]2", "2"]]}], "Lapb0"}], ")"}], 
    RowBox[{"-", "1"}]], 
   RowBox[{"NIntegrate", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Sinc", "[", 
       RowBox[{
        SuperscriptBox["E", "lnk"], "x"}], "]"}], 
      FractionBox["1", 
       RowBox[{"Sqrt", "[", 
        RowBox[{"2", "\[Pi]", " ", "s2b"}], "]"}]], 
      RowBox[{"Exp", "[", 
       FractionBox[
        RowBox[{"-", 
         SuperscriptBox["lnk", "2"]}], 
        RowBox[{"2", "s2b"}]], "]"}], 
      RowBox[{"Sqrt", "[", 
       RowBox[{"calPz", "[", "lnk", "]"}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"lnk", ",", 
       RowBox[{"-", "\[Infinity]"}], ",", "\[Infinity]"}], "}"}], ",", 
     RowBox[{"Method", "->", "\"\<GaussKronrodRule\>\""}], ",", 
     RowBox[{"WorkingPrecision", "->", "30"}]}], 
    "]"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"bp", "[", "x_", "]"}], ":=", 
  RowBox[{
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", 
       FractionBox[
        SuperscriptBox["\[Sigma]1", "2"], 
        SuperscriptBox["\[Sigma]2", "2"]]}], "Lapb0"}], ")"}], 
    RowBox[{"-", "1"}]], 
   RowBox[{"NIntegrate", "[", 
    RowBox[{
     RowBox[{
      SuperscriptBox["E", "lnk"], 
      RowBox[{
       RowBox[{"Sinc", "'"}], "[", 
       RowBox[{
        SuperscriptBox["E", "lnk"], "x"}], "]"}], 
      FractionBox["1", 
       RowBox[{"Sqrt", "[", 
        RowBox[{"2", "\[Pi]", " ", "s2b"}], "]"}]], 
      RowBox[{"Exp", "[", 
       FractionBox[
        RowBox[{"-", 
         SuperscriptBox["lnk", "2"]}], 
        RowBox[{"2", "s2b"}]], "]"}], 
      RowBox[{"Sqrt", "[", 
       RowBox[{"calPz", "[", "lnk", "]"}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"lnk", ",", 
       RowBox[{"-", "\[Infinity]"}], ",", "\[Infinity]"}], "}"}], ",", 
     RowBox[{"Method", "->", "\"\<GaussKronrodRule\>\""}], ",", 
     RowBox[{"WorkingPrecision", "->", "30"}]}], "]"}]}]}]}], "Input",
 CellChangeTimes->{{4.000109171105967*^9, 4.000109256901018*^9}, {
