       RowBox[{"Erf", "[", 
        RowBox[{
         RowBox[{"Sqrt", "[", 
          FractionBox["5", "2"], "]"}], "x"}], "]"}]}], ")"}]}], "+", 
    RowBox[{
     RowBox[{"Sqrt", "[", 
      FractionBox["2", 
       RowBox[{"5", "\[Pi]"}]], "]"}], 
     RowBox[{"(", 
