Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"\[Zeta]t", "[", 
    RowBox[{"x_", ",", "nu2_", ",", "k3t_"}], "]"}], "=", 
   RowBox[{
    RowBox[{
     RowBox[{"Sqrt", "[", 
      RowBox[{"\[Sigma]n2", "[", 
       RowBox[{"0", ",", "s2s"}], "]"}], "]"}], 
     FractionBox[
      RowBox[{
       RowBox[{"\[Gamma]n", "[", "s2s", "]"}], "nu2"}], 
      RowBox[{"1", "-", 
       SuperscriptBox[
        RowBox[{"\[Gamma]n", "[", "s2s", "]"}], "2"]}]], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", "-", 
          RowBox[{
           RowBox[{"\[Gamma]n", "[", "s2s", "]"}], 
           SuperscriptBox["k3t", "2"]}]}], ")"}], 
        RowBox[{"\[Psi]1int", "[", "x", "]"}]}], "+", 
       RowBox[{
        SuperscriptBox[
         RowBox[{"\[Gamma]n", "[", "s2s", "]"}], "3"], 
        RowBox[{"(", 
         RowBox[{
          SuperscriptBox["k3t", "2"], "-", 
          RowBox[{"\[Gamma]n", "[", "s2s", "]"}]}], ")"}], 
        RowBox[{"\[Psi]2int", "[", "x", "]"}]}]}], ")"}]}], "/.", 
    RowBox[{"{", 
     RowBox[{"Ag", "\[Rule]", "As"}], "}"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Zeta]tp", "[", 
    RowBox[{"x_", ",", "nu2_", ",", "k3t_"}], "]"}], "=", 
   RowBox[{
    RowBox[{
     RowBox[{"Sqrt", "[", 
      RowBox[{"\[Sigma]n2", "[", 
       RowBox[{"0", ",", "s2s"}], "]"}], "]"}], 
     FractionBox[
      RowBox[{
       RowBox[{"\[Gamma]n", "[", "s2s", "]"}], "nu2"}], 
      RowBox[{"1", "-", 
       SuperscriptBox[
        RowBox[{"\[Gamma]n", "[", "s2s", "]"}], "2"]}]], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", "-", 
          RowBox[{
           RowBox[{"\[Gamma]n", "[", "s2s", "]"}], 
           SuperscriptBox["k3t", "2"]}]}], ")"}], 
        RowBox[{"\[Psi]1pint", "[", "x", "]"}]}], "+", 
       RowBox[{
        SuperscriptBox[
         RowBox[{"\[Gamma]n", "[", "s2s", "]"}], "3"], 
        RowBox[{"(", 
         RowBox[{
          SuperscriptBox["k3t", "2"], "-", 
          RowBox[{"\[Gamma]n", "[", "s2s", "]"}]}], ")"}], 
        RowBox[{"\[Psi]2pint", "[", "x", "]"}]}]}], ")"}]}], "/.", 
    RowBox[{"{", 
     RowBox[{"Ag", "\[Rule]", "As"}], "}"}]}]}], ";"}]}], "Input",
