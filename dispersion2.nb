        RowBox[{"n", ",", "s2"}], "]"}]], 
      SuperscriptBox["E", 
       RowBox[{"2", "n", " ", "lnk"}]], 
      RowBox[{"calPz", "[", 
       RowBox[{"lnk", ",", "s2"}], "]"}], 
      SuperscriptBox[
       RowBox[{"WRTH", "[", 
        RowBox[{
         SuperscriptBox["E", "lnk"], "x"}], "]"}], "2"]}], "//", "Simplify"}],
     ",", 
    RowBox[{"{", 
     RowBox[{"lnk", ",", 
      RowBox[{"-", "\[Infinity]"}], ",", "\[Infinity]"}], "}"}], ",", 
    RowBox[{"Method", "->", "\"\<GaussKronrodRule\>\""}], ",", 
    RowBox[{"WorkingPrecision", "->", "30"}]}], "]"}]}]}], "Input",
