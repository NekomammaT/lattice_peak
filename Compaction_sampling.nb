        RowBox[{"Exp", "[", 
         RowBox[{
          FractionBox[
           RowBox[{"-", "5"}], "8"], 
          SuperscriptBox["x", "2"]}], "]"}]}], "+", 
       RowBox[{
        RowBox[{"(", 
