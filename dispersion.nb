Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"meanC", "[", "r_", "]"}], "=", 
  RowBox[{
   RowBox[{
    FractionBox["4", "3"], 
    FractionBox["1", "r"], 
    RowBox[{"Integrate", "[", 
     RowBox[{
      RowBox[{
       SuperscriptBox["rp", "2"], 
       RowBox[{"meanz", "[", "r", "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"rp", ",", "0", ",", "r"}], "}"}]}], "]"}]}], 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"+", 
      FractionBox["2", "3"]}], 
     FractionBox["1", "r"], 
     RowBox[{"Integrate", "[", 
      RowBox[{
       RowBox[{
        SuperscriptBox["rp", "2"], 
        RowBox[{"varz", "[", "r", "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"rp", ",", "0", ",", "r"}], "}"}]}], "]"}]}], "*)"}], "//", 
   "Simplify"}]}]], "Input",
 CellChangeTimes->{{3.998438540511107*^9, 3.998438698266325*^9}, {
   3.998438756987567*^9, 3.998438759924745*^9}, {3.998439006276186*^9, 
   3.9984390090114326`*^9}, {3.998439292758856*^9, 3.99843930597888*^9}, 
   3.998439399512373*^9},
 CellLabel->"In[56]:=",ExpressionUUID->"6d87a3d0-b51e-4ee3-90b8-8affab645be9"],

Cell[BoxData[
 FractionBox[
  RowBox[{"4", " ", "m2", " ", 
   SuperscriptBox["r", "2"], " ", 
   RowBox[{"Sinc", "[", 
    RowBox[{"ks", " ", "r"}], "]"}]}], 
  RowBox[{"9", " ", 
   SuperscriptBox["ks", "2"]}]]], "Output",
 CellChangeTimes->{
  3.998438569646214*^9, 3.998438616002112*^9, {3.9984386839893436`*^9, 
   3.9984386996899023`*^9}, 3.9984387625140047`*^9, 3.9984390100883617`*^9, 
   3.998439158684094*^9, 3.998439307521928*^9, 3.998439400213806*^9},
 CellLabel->"Out[56]=",ExpressionUUID->"e46dde60-7778-4d0b-bcf3-ee4aca0e78cd"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"typicalC", "[", "r_", "]"}], "=", 
  RowBox[{
   RowBox[{
    FractionBox["2", "3"], 
    RowBox[{"(", 
     RowBox[{"1", "-", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"1", "+", 
         RowBox[{"r", " ", 
          RowBox[{
           RowBox[{"meanz", "'"}], "[", "r", "]"}]}]}], ")"}], "2"]}], 
     ")"}]}], "//", "Simplify"}]}]], "Input",
 CellChangeTimes->{{3.998438704011579*^9, 3.9984387368512774`*^9}, {
  3.9984387801791487`*^9, 3.9984387826364937`*^9}, {3.9984391977711763`*^9, 
  3.9984392010901623`*^9}},
 CellLabel->"In[54]:=",ExpressionUUID->"a43ae985-34b0-4e0f-bff5-ffaa53b974f7"],

Cell[BoxData[
 RowBox[{
  FractionBox["2", "3"], " ", 
  RowBox[{"(", 
   RowBox[{"1", "-", 
    FractionBox[
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         SuperscriptBox["ks", "3"], " ", "r"}], "+", 
        RowBox[{"ks", " ", "m2", " ", "r", " ", 
         RowBox[{"Cos", "[", 
          RowBox[{"ks", " ", "r"}], "]"}]}], "-", 
        RowBox[{"m2", " ", 
         RowBox[{"Sin", "[", 
          RowBox[{"ks", " ", "r"}], "]"}]}]}], ")"}], "2"], 
     RowBox[{
      SuperscriptBox["ks", "6"], " ", 
      SuperscriptBox["r", "2"]}]]}], ")"}]}]], "Output",
 CellChangeTimes->{{3.9984387344319057`*^9, 3.998438737236038*^9}, 
