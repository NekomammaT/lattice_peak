Cell[BoxData[
 SqrtBox[
  RowBox[{
   SuperscriptBox["x", "2"], "+", 
   SuperscriptBox["y", "2"], "-", 
   RowBox[{"2", " ", "x", " ", "y", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"Cos", "[", "\[Theta]x", "]"}], " ", 
       RowBox[{"Cos", "[", "\[Theta]y", "]"}]}], "+", 
      RowBox[{
       RowBox[{"Cos", "[", 
        RowBox[{"\[Phi]x", "-", "\[Phi]y"}], "]"}], " ", 
       RowBox[{"Sin", "[", "\[Theta]x", "]"}], " ", 
       RowBox[{"Sin", "[", "\[Theta]y", "]"}]}]}], ")"}]}]}]]], "Output",
