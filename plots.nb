        RowBox[{"(", 
         RowBox[{"1", "-", 
          RowBox[{
           RowBox[{"\[Gamma]n", "[", "s2s", "]"}], 
           SuperscriptBox["k3t", "2"]}]}], ")"}], 
        RowBox[{"\[Psi]1pint", "[", "x", "]"}]}], "+", 
       RowBox[{
        SuperscriptBox[
         RowBox[{"\[Gamma]n", "[", "s2s", "]"}], "3"], 
        RowBox[{"(", 
         RowBox[{
