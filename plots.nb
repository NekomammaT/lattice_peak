Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"nu2inCk", "[", 
    RowBox[{"Cm_", ",", "k3t_"}], "]"}], "=", 
   FractionBox[
    RowBox[{
     RowBox[{"Sqrt", "[", 
      RowBox[{"1", "-", 
       RowBox[{
        FractionBox["3", "2"], "Cm"}]}], "]"}], "-", "1"}], 
    RowBox[{
     RowBox[{"xmint", "[", "k3t", "]"}], 
     FractionBox[
      SuperscriptBox["\[Sigma]1", "2"], "\[Sigma]2"], 
     RowBox[{"Sqrt", "[", "As", "]"}], 
     RowBox[{"\[Zeta]p", "[", 
      RowBox[{
       RowBox[{"xmint", "[", "k3t", "]"}], ",", "k3t"}], "]"}]}]]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"dnu2dCm", "[", 
    RowBox[{"Cm_", ",", "k3t_"}], "]"}], "=", 
   RowBox[{
    RowBox[{
     SubscriptBox["\[PartialD]", "Cm"], 
     RowBox[{"nu2inCk", "[", 
      RowBox[{"Cm", ",", "k3t"}], "]"}]}], "//", "Simplify"}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.998703451763269*^9, 3.998703473187332*^9}, {
  3.998703516668805*^9, 3.9987035413995333`*^9}, {3.998703965125516*^9, 
  3.998703990308751*^9}, {3.998704078359544*^9, 3.998704086527691*^9}},
 CellLabel->"In[39]:=",ExpressionUUID->"d6b164c1-8fb2-4610-93be-cf7b4b8a4dec"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", "x_", "]"}], "=", 
   RowBox[{
    RowBox[{
     FractionBox["1", "2"], "x", 
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox["x", "2"], "-", "3"}], ")"}], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"Erf", "[", 
        RowBox[{
         FractionBox["1", "2"], 
         RowBox[{"Sqrt", "[", 
          FractionBox["5", "2"], "]"}], "x"}], "]"}], "+", 
       RowBox[{"Erf", "[", 
        RowBox[{
         RowBox[{"Sqrt", "[", 
          FractionBox["5", "2"], "]"}], "x"}], "]"}]}], ")"}]}], "+", 
    RowBox[{
     RowBox[{"Sqrt", "[", 
      FractionBox["2", 
       RowBox[{"5", "\[Pi]"}]], "]"}], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          FractionBox["8", "5"], "+", 
          RowBox[{
           FractionBox["31", "4"], 
           SuperscriptBox["x", "2"]}]}], ")"}], 
        RowBox[{"Exp", "[", 
         RowBox[{
          FractionBox[
           RowBox[{"-", "5"}], "8"], 
          SuperscriptBox["x", "2"]}], "]"}]}], "+", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          FractionBox[
           RowBox[{"-", "8"}], "5"], "+", 
          RowBox[{
           FractionBox["1", "2"], 
           SuperscriptBox["x", "2"]}]}], ")"}], 
        RowBox[{"Exp", "[", 
         RowBox[{
          FractionBox[
           RowBox[{"-", "5"}], "2"], 
          SuperscriptBox["x", "2"]}], "]"}]}]}], ")"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"P13", "[", 
    RowBox[{"\[Nu]_", ",", "\[Xi]_"}], "]"}], "=", 
   RowBox[{
    FractionBox["1", 
     RowBox[{"2", "\[Pi]", " ", 
      RowBox[{"Sqrt", "[", 
       RowBox[{"1", "-", 
        SuperscriptBox["\[Gamma]n", "2"]}], "]"}]}]], 
    RowBox[{"Exp", "[", 
     RowBox[{
      FractionBox[
       RowBox[{"-", "1"}], "2"], 
      RowBox[{"(", 
       RowBox[{
        SuperscriptBox["\[Nu]", "2"], "+", 
        FractionBox[
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"\[Xi]", "-", 
            RowBox[{"\[Gamma]n", " ", "\[Nu]"}]}], ")"}], "2"], 
         RowBox[{"1", "-", 
          SuperscriptBox["\[Gamma]n", "2"]}]]}], ")"}]}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"npkPT", "[", 
    RowBox[{"nu2_", ",", "k3t_"}], "]"}], "=", 
   RowBox[{
    FractionBox["2", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"6", "\[Pi]"}], ")"}], 
      RowBox[{"3", "/", "2"}]]], 
    SuperscriptBox[
     RowBox[{"(", 
      FractionBox["\[Sigma]4", "\[Sigma]3"], ")"}], "3"], " ", "nu2", " ", 
    "k3t", " ", 
    RowBox[{"f", "[", 
     RowBox[{"nu2", " ", 
      SuperscriptBox["k3t", "2"]}], "]"}], 
    RowBox[{"P13", "[", 
     RowBox[{"nu2", ",", 
      RowBox[{"nu2", " ", 
       SuperscriptBox["k3t", "2"]}]}], "]"}]}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.992389135040773*^9, 3.992389209747291*^9}, {
  3.9923892831911173`*^9, 3.9923892942133636`*^9}, {3.992389414311263*^9, 
  3.992389414635908*^9}, {3.998703065396554*^9, 3.9987031090485983`*^9}},
 CellLabel->"In[41]:=",ExpressionUUID->"73459b58-fb25-4880-9dd3-2683c0b15d3a"],

