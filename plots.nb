 RowBox[{
  RowBox[{
   RowBox[{"Var\[Delta]", "[", "x_", "]"}], "=", 
   RowBox[{
    RowBox[{
     FractionBox["16", "81"], 
     RowBox[{"\[Sigma]n2", "[", 
