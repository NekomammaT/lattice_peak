Cell[BoxData[{
 RowBox[{
  RowBox[{"CprofDS", "=", 
   RowBox[{"Join", "@@", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"Import", "[", 
       RowBox[{"\"\<data/paper/LN_\>\"", "<>", "s2string", 
        "<>", "\"\</LN_Cprof_\>\"", "<>", "s2string", "<>", "\"\<_256_16_\>\"",
         "<>", 
        RowBox[{"ToString", "[", "i", "]"}], "<>", "\"\<.csv\>\""}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "0", ",", "99"}], "}"}]}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"nuP", "=", 
   RowBox[{
    RowBox[{"CprofDS", "[", 
     RowBox[{"[", 
      RowBox[{"All", ",", "4"}], "]"}], "]"}], "/", "\[Sigma]2"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"k3P", "=", 
   RowBox[{
    RowBox[{"CprofDS", "[", 
     RowBox[{"[", 
      RowBox[{"All", ",", "5"}], "]"}], "]"}], 
    RowBox[{"Sqrt", "[", 
     RowBox[{"\[Sigma]2", "/", "\[Sigma]4"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"nuk3P", "=", 
   RowBox[{
    RowBox[{"CprofDS", "[", 
     RowBox[{"[", 
      RowBox[{"All", ",", 
       RowBox[{"4", ";;", "5"}]}], "]"}], "]"}], ".", 
    RowBox[{"DiagonalMatrix", "[", 
     RowBox[{"{", 
      RowBox[{
       FractionBox["1", "\[Sigma]2"], ",", 
       RowBox[{"Sqrt", "[", 
        FractionBox["\[Sigma]2", "\[Sigma]4"], "]"}]}], "}"}], "]"}]}]}], 
  ";"}]}], "Input",
