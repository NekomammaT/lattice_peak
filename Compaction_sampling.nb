Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", "x_", "]"}], "=", 
   RowBox[{
    RowBox[{
     FractionBox["1", "2"], "x", 
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox["x", "2"], "-", "3"}], ")"}], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"Erf", "[", 
        RowBox[{
         FractionBox["1", "2"], 
         RowBox[{"Sqrt", "[", 
          FractionBox["5", "2"], "]"}], "x"}], "]"}], "+", 
       RowBox[{"Erf", "[", 
        RowBox[{
         RowBox[{"Sqrt", "[", 
          FractionBox["5", "2"], "]"}], "x"}], "]"}]}], ")"}]}], "+", 
    RowBox[{
     RowBox[{"Sqrt", "[", 
      FractionBox["2", 
       RowBox[{"5", "\[Pi]"}]], "]"}], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          FractionBox["8", "5"], "+", 
          RowBox[{
           FractionBox["31", "4"], 
           SuperscriptBox["x", "2"]}]}], ")"}], 
        RowBox[{"Exp", "[", 
         RowBox[{
          FractionBox[
           RowBox[{"-", "5"}], "8"], 
          SuperscriptBox["x", "2"]}], "]"}]}], "+", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          FractionBox[
           RowBox[{"-", "8"}], "5"], "+", 
          RowBox[{
           FractionBox["1", "2"], 
           SuperscriptBox["x", "2"]}]}], ")"}], 
        RowBox[{"Exp", "[", 
         RowBox[{
          FractionBox[
