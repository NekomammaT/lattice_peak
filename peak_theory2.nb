Cell[BoxData[
 RowBox[{
  RowBox[{"focusedlap2D", "=", 
   RowBox[{"Flatten", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"nx", "<", "0"}], ",", 
          RowBox[{"nxt", "=", 
           RowBox[{"nx", "+", "NL"}]}], ",", 
          RowBox[{"nxt", "=", "nx"}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"nz", "<", "0"}], ",", 
          RowBox[{"nzt", "=", 
           RowBox[{"nz", "+", "NL"}]}], ",", 
          RowBox[{"nzt", "=", "nz"}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{"nx", ",", "nz", ",", 
          RowBox[{"lapmap", "[", 
           RowBox[{"[", 
            RowBox[{
             RowBox[{
              SuperscriptBox["NL", "2"], "nxt"}], "+", "nzt", "+", "1"}], 
            "]"}], "]"}]}], "}"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"nx", ",", 
         RowBox[{
          RowBox[{"-", "10"}], 
          RowBox[{"Ceiling", "[", 
           FractionBox["NL", 
            RowBox[{"2", "\[Pi]", " ", "npeak"}]], "]"}]}], ",", 
         RowBox[{"10", 
          RowBox[{"Ceiling", "[", 
           FractionBox["NL", 
            RowBox[{"2", "\[Pi]", " ", "npeak"}]], "]"}]}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"nz", ",", 
         RowBox[{
          RowBox[{"-", "10"}], 
          RowBox[{"Ceiling", "[", 
           FractionBox["NL", 
            RowBox[{"2", "\[Pi]", " ", "npeak"}]], "]"}]}], ",", 
         RowBox[{"10", 
          RowBox[{"Ceiling", "[", 
           FractionBox["NL", 
            RowBox[{"2", "\[Pi]", " ", "npeak"}]], "]"}]}]}], "}"}]}], "]"}], 
     ",", "1"}], "]"}]}], ";"}]], "Input",
