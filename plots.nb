Cell[BoxData[{
 RowBox[{
  RowBox[{"CprofDS", "=", 
   RowBox[{"Join", "@@", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"Import", "[", 
       RowBox[{
       "\"\<data/paper/LN_\>\"", "<>", "s2string", "<>", "\"\</LN_Cprof_\>\"",
