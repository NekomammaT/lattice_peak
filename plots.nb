       RowBox[{"Nsim", "-", "1"}]}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"nuP", "=", 
   RowBox[{
    RowBox[{"Lpeak", "[", 
     RowBox[{"[", 
      RowBox[{"All", ",", "All", ",", "4"}], "]"}], "]"}], "/", 
