       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", "-", 
          RowBox[{
           RowBox[{"\[Gamma]n", "[", "s2s", "]"}], 
           SuperscriptBox["k3t", "2"]}]}], ")"}], 
        RowBox[{"\[Psi]1int", "[", "x", "]"}]}], "+", 
       RowBox[{
        SuperscriptBox[
         RowBox[{"\[Gamma]n", "[", "s2s", "]"}], "3"], 
        RowBox[{"(", 
         RowBox[{
          SuperscriptBox["k3t", "2"], "-", 
          RowBox[{"\[Gamma]n", "[", "s2s", "]"}]}], ")"}], 
        RowBox[{"\[Psi]2int", "[", "x", "]"}]}]}], ")"}]}], "/.", 
    RowBox[{"{", 
     RowBox[{"Ag", "\[Rule]", "As"}], "}"}]}]}], ";"}], "\[IndentingNewLine]", 
