      RowBox[{"xm", "->", "2.74"}]}], "}"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Mks", "[", "ks_", "]"}], "=", 
   SuperscriptBox[
