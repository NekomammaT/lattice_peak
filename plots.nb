 RowBox[{
  RowBox[{"\[Sigma]4", "=", 
   RowBox[{
    RowBox[{"Sqrt", "[", 
     RowBox[{
      SuperscriptBox["E", 
       RowBox[{"2", 
        SuperscriptBox["n", "2"], "s2"}]], 
