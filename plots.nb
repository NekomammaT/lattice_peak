           RowBox[{"\[Gamma]n", "[", "s2s", "]"}], 
           SuperscriptBox["k3t", "2"]}]}], ")"}], 
        RowBox[{"\[Psi]1int", "[", "x", "]"}]}], "+", 
       RowBox[{
        SuperscriptBox[
