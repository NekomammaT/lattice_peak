Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Cpk", "[", "x_", "]"}], "=", 
   RowBox[{
    RowBox[{
     FractionBox["2", "3"], 
     RowBox[{"(", 
      RowBox[{"1", "-", 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"1", "+", 
          RowBox[{"x", " ", 
           RowBox[{"Sqrt", "[", "As", "]"}], 
           FractionBox[
            SuperscriptBox["\[Sigma]1", "2"], "\[Sigma]2"], "\[Nu]2", " ", 
           RowBox[{"\[Zeta]p", "[", 
            RowBox[{"x", ",", "k3tb"}], "]"}]}]}], ")"}], "2"]}], ")"}]}], "/.", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"As", "->", 
       RowBox[{"5", " ", 
        SuperscriptBox["10", 
         RowBox[{"-", "3"}]]}]}], ",", 
      RowBox[{"\[Nu]2", "->", "8"}]}], "}"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Cbias", "[", "x_", "]"}], "=", 
   RowBox[{
    RowBox[{
     FractionBox["2", "3"], 
     RowBox[{"(", 
      RowBox[{"1", "-", 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"1", "+", 
          RowBox[{"x", " ", 
           RowBox[{"Sqrt", "[", "As", "]"}], 
           FractionBox[
            SuperscriptBox["\[Sigma]1", "2"], "\[Sigma]2"], "\[Nu]2", " ", 
           RowBox[{"bpint", "[", "x", "]"}]}]}], ")"}], "2"]}], ")"}]}], "/.", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"As", "->", 
       RowBox[{"5", " ", 
        SuperscriptBox["10", 
         RowBox[{"-", "3"}]]}]}], ",", 
      RowBox[{"\[Nu]2", "->", "8"}]}], "}"}]}]}], ";"}]}], "Input",
