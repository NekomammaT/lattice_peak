Cell[BoxData[
 RowBox[{
  RowBox[{"Nsim", "=", "100"}], ";"}]], "Input",
 CellChangeTimes->{{4.003550215480002*^9, 4.0035502176876497`*^9}},
 CellLabel->"In[13]:=",ExpressionUUID->"4457c778-f6a1-4a6d-a3f0-74068e8b5410"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Lpeak", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Import", "[", 
      RowBox[{"\"\<data/paper/mono/mono_Lpeak_256_16_\>\"", "<>", 
       RowBox[{"ToString", "[", "i", "]"}], "<>", "\"\<.csv\>\""}], "]"}], 
     ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "0", ",", 
       RowBox[{"Nsim", "-", "1"}]}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"nuP", "=", 
   RowBox[{
    RowBox[{"Lpeak", "[", 
     RowBox[{"[", 
      RowBox[{"All", ",", "All", ",", "4"}], "]"}], "]"}], "/", 
    "\[Sigma]2"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"k3P", "=", 
   RowBox[{
    RowBox[{"Lpeak", "[", 
     RowBox[{"[", 
      RowBox[{"All", ",", "All", ",", "5"}], "]"}], "]"}], 
    RowBox[{"Sqrt", "[", 
     RowBox[{"\[Sigma]2", "/", "\[Sigma]4"}], "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"nuk3P", "=", 
   RowBox[{
    RowBox[{"Flatten", "[", 
     RowBox[{
      RowBox[{"Lpeak", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", "All", ",", 
         RowBox[{"4", ";;", "5"}]}], "]"}], "]"}], ",", "1"}], "]"}], ".", 
    RowBox[{"DiagonalMatrix", "[", 
     RowBox[{"{", 
      RowBox[{
       FractionBox["1", "\[Sigma]2"], ",", 
       RowBox[{"Sqrt", "[", 
        FractionBox["\[Sigma]2", "\[Sigma]4"], "]"}]}], "}"}], "]"}]}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{4.003548951070753*^9, 4.00354895868388*^9}, {
