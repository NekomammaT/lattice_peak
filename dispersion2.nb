Cell[BoxData[
 RowBox[{
  RowBox[{"\[Psi]n", "[", 
   RowBox[{"x_", ",", "n_", ",", "s2_"}], "]"}], ":=", 
  RowBox[{"NIntegrate", "[", 
   RowBox[{
    RowBox[{"Simplify", "[", 
     RowBox[{
      FractionBox[
       SuperscriptBox["ks", 
        RowBox[{"2", "n"}]], 
       RowBox[{"\[Sigma]n2", "[", 
        RowBox[{"n", ",", "s2"}], "]"}]], 
      SuperscriptBox["E", 
       RowBox[{"2", "n", " ", "lnk"}]], 
      RowBox[{"calPz", "[", 
       RowBox[{"lnk", ",", "s2"}], "]"}], 
      RowBox[{"Sinc", "[", 
       RowBox[{
        SuperscriptBox["E", "lnk"], "x"}], "]"}]}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"lnk", ",", 
      RowBox[{"-", "\[Infinity]"}], ",", "\[Infinity]"}], "}"}], ",", 
    RowBox[{"Method", "->", "\"\<GaussKronrodRule\>\""}], ",", 
    RowBox[{"WorkingPrecision", "->", "30"}]}], "]"}]}]], "Input",
 CellLabel->"In[11]:=",ExpressionUUID->"3122b146-435d-4ba8-a278-780d7f25b160"],

