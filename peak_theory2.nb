      RowBox[{"Cth", "->", "0.533"}], ",", 
      RowBox[{"\[Gamma]", "->", "0.36"}], ",", 
      RowBox[{"xm", "->", "2.74"}]}], "}"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Mks", "[", "ks_", "]"}], "=", 
   SuperscriptBox[
    RowBox[{"(", 
