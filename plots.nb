Cell[BoxData[{
 RowBox[{
  RowBox[{"\[Sigma]1", "=", 
   FractionBox[
    RowBox[{"2", "\[Pi]", " ", "npeak"}], "NL"]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Sigma]2", "=", 
   SuperscriptBox["\[Sigma]1", "2"]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Sigma]3", "=", 
