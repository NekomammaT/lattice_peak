Cell[BoxData[{
 RowBox[{
  RowBox[{"\[Sigma]1", "=", 
   RowBox[{
    RowBox[{"Sqrt", "[", 
     RowBox[{
      SuperscriptBox["E", 
       RowBox[{"2", 
        SuperscriptBox["n", "2"], "s2"}]], 
      SuperscriptBox[
       RowBox[{"(", 
        FractionBox[
         RowBox[{"2", "\[Pi]", " ", "npeak"}], "NL"], ")"}], 
       RowBox[{"2", "n"}]]}], "]"}], "/.", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"n", "->", "1"}], ",", 
      RowBox[{"s2", "->", "s2s"}]}], "}"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Sigma]2", "=", 
   RowBox[{
    RowBox[{"Sqrt", "[", 
