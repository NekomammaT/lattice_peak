Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"calPz", "[", 
    RowBox[{"lnk_", ",", "s2_"}], "]"}], "=", 
   RowBox[{
    FractionBox["Ag", 
     RowBox[{"Sqrt", "[", 
      RowBox[{"2", "\[Pi]", " ", "s2"}], "]"}]], 
    RowBox[{"Exp", "[", 
     FractionBox[
      RowBox[{"-", 
       SuperscriptBox["lnk", "2"]}], 
      RowBox[{"2", "s2"}]], "]"}]}]}], ";"}]], "Input",
