 CellLabel->"In[8]:=",ExpressionUUID->"167d6b32-32bf-4a97-8dc4-737fdb11741a"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"dlnMdmu2", "[", 
    RowBox[{"nu2_", ",", "As_"}], "]"}], "=", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"2", 
       RowBox[{"Sqrt", "[", "As", "]"}], 
       RowBox[{"Sinc", "[", "xm", "]"}]}], "+", 
      RowBox[{
       FractionBox["\[Gamma]", 
        RowBox[{
         RowBox[{"Cm", "[", 
          RowBox[{"nu2", ",", "As"}], "]"}], "-", "Cth"}]], 
       RowBox[{
        SubscriptBox["\[PartialD]", "nu2"], 
        RowBox[{"Cm", "[", 
         RowBox[{"nu2", ",", "As"}], "]"}]}]}]}], "/.", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Cth", "->", "0.533"}], ",", 
       RowBox[{"\[Gamma]", "->", "0.36"}], ",", 
       RowBox[{"xm", "->", "2.74"}]}], "}"}]}], "//", "Simplify"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.981017373769113*^9, 3.9810174059479837`*^9}, {
  3.9810174573576736`*^9, 3.98101749771977*^9}, {3.99429373783987*^9, 
