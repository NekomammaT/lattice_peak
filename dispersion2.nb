Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Delta\[Zeta]", "[", "x_", "]"}], "=", 
   RowBox[{"Sqrt", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"\[Sigma]n2", "[", 
       RowBox[{"0", ",", "s2s"}], "]"}], 
      RowBox[{"(", 
       RowBox[{"1", "-", 
        RowBox[{
         FractionBox[
          SuperscriptBox[
           RowBox[{"\[Gamma]n", "[", "s2s", "]"}], "2"], 
          RowBox[{"1", "-", 
           SuperscriptBox[
            RowBox[{"\[Gamma]n", "[", "s2s", "]"}], "2"]}]], 
         RowBox[{"(", 
          RowBox[{
           SuperscriptBox[
            RowBox[{"\[Psi]1int", "[", "x", "]"}], "2"], "-", 
           RowBox[{"2", 
            SuperscriptBox[
             RowBox[{"\[Gamma]n", "[", "s2s", "]"}], "4"], 
            RowBox[{"\[Psi]1int", "[", "x", "]"}], 
            RowBox[{"\[Psi]2int", "[", "x", "]"}]}], "+", 
           RowBox[{
            SuperscriptBox[
             RowBox[{"\[Gamma]n", "[", "s2s", "]"}], "6"], 
            SuperscriptBox[
             RowBox[{"\[Psi]2int", "[", "x", "]"}], "2"]}]}], ")"}]}]}], 
       ")"}]}], "/.", 
     RowBox[{"{", 
      RowBox[{"Ag", "->", "As"}], "}"}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.998529863720129*^9, 3.998529999864663*^9}},
 CellLabel->"In[15]:=",ExpressionUUID->"c11f22d2-2144-4386-8d0a-2b03bee389a6"],

