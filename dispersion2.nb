   RowBox[{"x_", ",", "n_", ",", "s2_"}], "]"}], ":=", 
  RowBox[{"NIntegrate", "[", 
   RowBox[{
    RowBox[{"Simplify", "[", 
     RowBox[{
      FractionBox[
       SuperscriptBox["ks", 
        RowBox[{"2", "n"}]], 
       RowBox[{"\[Sigma]n2", "[", 
        RowBox[{"n", ",", "s2"}], "]"}]], 
      SuperscriptBox["E", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"2", "n"}], "+", "1"}], ")"}], " ", "lnk"}]], 
      RowBox[{"calPz", "[", 
       RowBox[{"lnk", ",", "s2"}], "]"}], 
      RowBox[{
       RowBox[{"Sinc", "'"}], "[", 
       RowBox[{
        SuperscriptBox["E", "lnk"], "x"}], "]"}]}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"lnk", ",", 
      RowBox[{"-", "\[Infinity]"}], ",", "\[Infinity]"}], "}"}], ",", 
    RowBox[{"Method", "->", "\"\<GaussKronrodRule\>\""}], ",", 
    RowBox[{"WorkingPrecision", "->", "30"}]}], "]"}]}]}], "Input",
