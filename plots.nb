Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", "x_", "]"}], "=", 
   RowBox[{
    RowBox[{
     FractionBox["1", "2"], "x", 
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox["x", "2"], "-", "3"}], ")"}], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"Erf", "[", 
        RowBox[{
         FractionBox["1", "2"], 
         RowBox[{"Sqrt", "[", 
          FractionBox["5", "2"], "]"}], "x"}], "]"}], "+", 
       RowBox[{"Erf", "[", 
        RowBox[{
         RowBox[{"Sqrt", "[", 
          FractionBox["5", "2"], "]"}], "x"}], "]"}]}], ")"}]}], "+", 
    RowBox[{
     RowBox[{"Sqrt", "[", 
      FractionBox["2", 
       RowBox[{"5", "\[Pi]"}]], "]"}], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          FractionBox["8", "5"], "+", 
          RowBox[{
           FractionBox["31", "4"], 
           SuperscriptBox["x", "2"]}]}], ")"}], 
        RowBox[{"Exp", "[", 
         RowBox[{
          FractionBox[
           RowBox[{"-", "5"}], "8"], 
          SuperscriptBox["x", "2"]}], "]"}]}], "+", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          FractionBox[
           RowBox[{"-", "8"}], "5"], "+", 
          RowBox[{
           FractionBox["1", "2"], 
           SuperscriptBox["x", "2"]}]}], ")"}], 
        RowBox[{"Exp", "[", 
         RowBox[{
          FractionBox[
           RowBox[{"-", "5"}], "2"], 
          SuperscriptBox["x", "2"]}], "]"}]}]}], ")"}]}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"P13", "[", 
    RowBox[{"\[Nu]_", ",", "\[Xi]_"}], "]"}], "=", 
   RowBox[{
    FractionBox["1", 
     RowBox[{"2", "\[Pi]", " ", 
      RowBox[{"Sqrt", "[", 
       RowBox[{"1", "-", 
        SuperscriptBox["\[Gamma]n", "2"]}], "]"}]}]], 
    RowBox[{"Exp", "[", 
     RowBox[{
      FractionBox[
       RowBox[{"-", "1"}], "2"], 
      RowBox[{"(", 
       RowBox[{
        SuperscriptBox["\[Nu]", "2"], "+", 
        FractionBox[
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"\[Xi]", "-", 
            RowBox[{"\[Gamma]n", " ", "\[Nu]"}]}], ")"}], "2"], 
         RowBox[{"1", "-", 
          SuperscriptBox["\[Gamma]n", "2"]}]]}], ")"}]}], "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"npkPT", "[", 
    RowBox[{"nu2_", ",", "k3t_"}], "]"}], "=", 
   RowBox[{
    FractionBox["2", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"6", "\[Pi]"}], ")"}], 
      RowBox[{"3", "/", "2"}]]], 
    SuperscriptBox[
     RowBox[{"(", 
      FractionBox["\[Sigma]4", "\[Sigma]3"], ")"}], "3"], " ", "nu2", " ", 
    "k3t", " ", 
    RowBox[{"f", "[", 
     RowBox[{"nu2", " ", 
      SuperscriptBox["k3t", "2"]}], "]"}], 
    RowBox[{"P13", "[", 
     RowBox[{"nu2", ",", 
      RowBox[{"nu2", " ", 
       SuperscriptBox["k3t", "2"]}]}], "]"}]}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.992389135040773*^9, 3.992389209747291*^9}, {
