Cell[BoxData[{
 RowBox[{
  RowBox[{"wlnMList", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"lnM", ",", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Length", "[", 
           RowBox[{"lnMbinning", "[", "lnM", "]"}], "]"}], ">", "1"}], ",", 
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{"Mean", "[", 
            RowBox[{
             RowBox[{"lnMbinning", "[", "lnM", "]"}], "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", "3"}], "]"}], "]"}], "]"}], "+", 
           FractionBox[
            RowBox[{"Variance", "[", 
             RowBox[{
              RowBox[{"lnMbinning", "[", "lnM", "]"}], "[", 
              RowBox[{"[", 
               RowBox[{"All", ",", "3"}], "]"}], "]"}], "]"}], "2"]}], "]"}], 
         ",", "0"}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"lnM", ",", "lnMmin", ",", "lnMmax", ",", "DlnM"}], "}"}]}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"wlnMerrp", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"lnM", ",", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Length", "[", 
           RowBox[{"lnMbinning", "[", "lnM", "]"}], "]"}], ">", "1"}], ",", 
         RowBox[{"Abs", "[", 
          RowBox[{
           RowBox[{"Exp", "[", 
            RowBox[{"Sqrt", "[", 
             RowBox[{
              FractionBox[
               RowBox[{"Variance", "[", 
                RowBox[{
                 RowBox[{"lnMbinning", "[", "lnM", "]"}], "[", 
                 RowBox[{"[", 
                  RowBox[{"All", ",", "3"}], "]"}], "]"}], "]"}], 
               RowBox[{"Length", "[", 
                RowBox[{"lnMbinning", "[", "lnM", "]"}], "]"}]], "+", 
              FractionBox[
               SuperscriptBox[
                RowBox[{"Variance", "[", 
                 RowBox[{
                  RowBox[{"lnMbinning", "[", "lnM", "]"}], "[", 
                  RowBox[{"[", 
                   RowBox[{"All", ",", "3"}], "]"}], "]"}], "]"}], "2"], 
               RowBox[{
                RowBox[{"2", 
                 RowBox[{"Length", "[", 
                  RowBox[{"lnMbinning", "[", "lnM", "]"}], "]"}]}], "-", 
                "2"}]]}], "]"}], "]"}], "-", "1"}], "]"}], ",", "0"}], 
        "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"lnM", ",", "lnMmin", ",", "lnMmax", ",", "DlnM"}], "}"}]}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"wlnMerrm", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"lnM", ",", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Length", "[", 
           RowBox[{"lnMbinning", "[", "lnM", "]"}], "]"}], ">", "1"}], ",", 
         RowBox[{"Abs", "[", 
          RowBox[{
           RowBox[{"Exp", "[", 
            RowBox[{"-", 
             RowBox[{"Sqrt", "[", 
              RowBox[{
               FractionBox[
                RowBox[{"Variance", "[", 
                 RowBox[{
                  RowBox[{"lnMbinning", "[", "lnM", "]"}], "[", 
