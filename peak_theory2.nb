 RowBox[{
  RowBox[{
   RowBox[{"Cm", "[", 
    RowBox[{"\[Nu]2_", ",", "k3t_", ",", "Ag_"}], "]"}], "=", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{
      FractionBox["2", "3"], 
      RowBox[{"(", 
       RowBox[{"1", "-", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"1", "+", 
           RowBox[{
            RowBox[{"xmint", "[", "k3t", "]"}], " ", 
            FractionBox[
             RowBox[{"\[Sigma]n2", "[", 
              RowBox[{"1", ",", "s2s"}], "]"}], 
             RowBox[{"Sqrt", "[", 
              RowBox[{"\[Sigma]n2", "[", 
               RowBox[{"2", ",", "s2s"}], "]"}], "]"}]], " ", "\[Nu]2", " ", 
            RowBox[{"\[Zeta]p", "[", 
             RowBox[{
              RowBox[{"xmint", "[", "k3t", "]"}], ",", "k3t"}], "]"}]}]}], 
          ")"}], "2"]}], ")"}]}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Ag", ">", "0"}], ",", 
