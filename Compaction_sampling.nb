    SuperscriptBox["\[Sigma]3", "2"], 
    RowBox[{"\[Sigma]2", " ", "\[Sigma]4"}]]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", "x_", "]"}], "=", 
   RowBox[{
    RowBox[{
     FractionBox["1", "2"], "x", 
     RowBox[{"(", 
