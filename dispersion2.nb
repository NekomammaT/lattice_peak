          RowBox[{"\[Gamma]n", "[", "s2s", "]"}]}], ")"}], 
        RowBox[{"\[Psi]2int", "[", "x", "]"}]}]}], ")"}]}], "/.", 
    RowBox[{"{", 
     RowBox[{"Ag", "\[Rule]", "As"}], "}"}]}]}], ";"}], "\[IndentingNewLine]", 
