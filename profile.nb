Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"logM", "[", "u_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"c", ",", "xm", ",", "i", ",", "cc"}], "}"}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"c", ",", "xm", ",", "i"}], "}"}], "=", 
       RowBox[{"cmax", "[", "u", "]"}]}], ";", 
      RowBox[{"cc", "=", 
       RowBox[{"c", "-", "Cthm"}]}], ";", 
      RowBox[{
       RowBox[{"2", " ", 
        RowBox[{"Log", "[", "xm", "]"}]}], "+", 
       RowBox[{"2", " ", 
        RowBox[{
         RowBox[{
         "Amat", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}], ".", 
         "u"}]}], "+", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"cc", ">", 
          FractionBox["1", 
           SuperscriptBox["10", "6"]]}], ",", 
         RowBox[{"gamm", " ", 
          RowBox[{"Log", "[", "cc", "]"}]}], ",", 
         RowBox[{
          RowBox[{"gamm", " ", 
           RowBox[{"Log", "[", 
            FractionBox["1", 
             SuperscriptBox["10", "6"]], "]"}]}], "+", 
          RowBox[{"300", " ", 
           RowBox[{"(", 
            RowBox[{"cc", "-", 
             FractionBox["1", 
              SuperscriptBox["10", "6"]]}], ")"}]}]}]}], "]"}]}]}]}], "]"}]}],
   ";", 
  RowBox[{
   RowBox[{"Jf", "[", "u_", "]"}], ":=", 
   RowBox[{
    RowBox[{"logM", "[", "u", "]"}], "-", 
    FractionBox[
     RowBox[{"u", ".", "u"}], "2"]}]}], ";", 
  RowBox[{
   RowBox[{"bestAt", "[", "i_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"a", "=", 
        RowBox[{
        "Amat", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}]}], ",", 
       RowBox[{"b", "=", 
        RowBox[{
        "Bmat", "\[LeftDoubleBracket]", "i", "\[RightDoubleBracket]"}]}], ",", 
       RowBox[{"d", "=", 
        RowBox[{
         RowBox[{"Bmat", "\[LeftDoubleBracket]", 
          RowBox[{"Min", "[", 
           RowBox[{
            RowBox[{"i", "+", "1"}], ",", 
            RowBox[{"Length", "[", "xs", "]"}]}], "]"}], 
          "\[RightDoubleBracket]"}], "-", 
         RowBox[{"Bmat", "\[LeftDoubleBracket]", 
          RowBox[{"Max", "[", 
           RowBox[{
            RowBox[{"i", "-", "1"}], ",", "1"}], "]"}], 
          "\[RightDoubleBracket]"}]}]}], ",", "al", ",", "be", ",", "ga", ",",
        "r"}], "}"}], ",", 
     RowBox[{
      RowBox[{"r", "=", 
       RowBox[{"Quiet", "[", 
        RowBox[{"FindMaximum", "[", 
         RowBox[{
          RowBox[{"Jf", "[", 
           RowBox[{
            RowBox[{"al", " ", "b"}], "+", 
            RowBox[{"be", " ", "a"}], "+", 
            RowBox[{"ga", " ", "d"}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"al", ",", 
              FractionBox[
               RowBox[{"1.05`", " ", "vth"}], 
               RowBox[{
               "varv", "\[LeftDoubleBracket]", "i", 
                "\[RightDoubleBracket]"}]]}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"be", ",", "0.`"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"ga", ",", "0.`"}], "}"}]}], "}"}], ",", 
          RowBox[{"MaxIterations", "\[Rule]", "300"}]}], "]"}], "]"}]}], ";", 
      
      RowBox[{"{", 
       RowBox[{
        RowBox[{"r", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], 
        ",", 
        RowBox[{
         RowBox[{
          RowBox[{"al", " ", "b"}], "+", 
          RowBox[{"be", " ", "a"}], "+", 
          RowBox[{"ga", " ", "d"}]}], "/.", "\[VeryThinSpace]", 
         RowBox[{
         "r", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}]}]}], 
       "}"}]}]}], "]"}]}], ";"}]], "Input",
 CellLabel->
  "In[528]:=",ExpressionUUID->"bcd18803-5787-4e45-a9e7-52e4fe855a3d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"L2", "[", "u_", "]"}], ":=", 
   RowBox[{
    SuperscriptBox["kpm", "2"], " ", 
    RowBox[{"Total", "[", 
     RowBox[{
      RowBox[{"Exp", "[", 
       RowBox[{"2", " ", "lk"}], "]"}], " ", 
      SqrtBox[
       RowBox[{"Pz", " ", "dl"}]], " ", "u"}], "]"}]}]}], ";", 
  RowBox[{
   RowBox[{"L4", "[", "u_", "]"}], ":=", 
   RowBox[{
    SuperscriptBox["kpm", "4"], " ", 
    RowBox[{"Total", "[", 
     RowBox[{
      RowBox[{"Exp", "[", 
       RowBox[{"4", " ", "lk"}], "]"}], " ", 
      SqrtBox[
       RowBox[{"Pz", " ", "dl"}]], " ", "u"}], "]"}]}]}], ";", 
  RowBox[{
   RowBox[{"nuK", "[", "u_", "]"}], ":=", 
   RowBox[{"{", 
    RowBox[{
     FractionBox[
      RowBox[{"L2", "[", "u", "]"}], 
      RowBox[{"sig", "[", "2", "]"}]], ",", 
     SqrtBox[
      RowBox[{"Abs", "[", 
       FractionBox[
        RowBox[{
         RowBox[{"sig", "[", "2", "]"}], " ", 
         RowBox[{"L4", "[", "u", "]"}]}], 
        RowBox[{
         RowBox[{"sig", "[", "4", "]"}], " ", 
         RowBox[{"L2", "[", "u", "]"}]}]], "]"}]]}], "}"}]}], ";", 
  RowBox[{"Eg", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      SuperscriptBox["kpm", "2"], " ", 
      RowBox[{"Exp", "[", 
       RowBox[{"2", " ", "lk"}], "]"}], " ", 
      SqrtBox[
       RowBox[{"Pz", " ", "dl"}]]}], ",", 
     RowBox[{
      SuperscriptBox["kpm", "4"], " ", 
      RowBox[{"Exp", "[", 
       RowBox[{"4", " ", "lk"}], "]"}], " ", 
      SqrtBox[
       RowBox[{"Pz", " ", "dl"}]]}]}], "}"}]}], ";", 
  RowBox[{
   RowBox[{"utyp", "[", 
    RowBox[{"nu_", ",", "k3_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"Transpose", "[", "Eg", "]"}], ".", 
    RowBox[{"LinearSolve", "[", 
     RowBox[{
      RowBox[{"Eg", ".", 
       RowBox[{"Transpose", "[", "Eg", "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"nu", " ", 
         RowBox[{"sig", "[", "2", "]"}]}], ",", 
        RowBox[{
         SuperscriptBox["k3", "2"], " ", "nu", " ", 
         RowBox[{"sig", "[", "4", "]"}]}]}], "}"}]}], "]"}]}]}], ";", 
  RowBox[{"ubias0", "=", 
   RowBox[{
    SqrtBox["dl"], " ", 
    RowBox[{"PDF", "[", 
     RowBox[{
      RowBox[{"NormalDistribution", "[", 
       RowBox[{"0", ",", 
        SqrtBox["s2m"]}], "]"}], ",", "lk"}], "]"}]}]}], ";", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"nuK", "[", "uMPP", "]"}], ",", 
    RowBox[{"nuK", "[", "uTh", "]"}], ",", 
    RowBox[{"nuK", "[", "ubias0", "]"}]}], "}"}]}]], "Input",
 CellLabel->
  "In[529]:=",ExpressionUUID->"9f0d32ca-0a37-4760-8315-44c059669178"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
