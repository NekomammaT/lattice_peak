Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"nu2inCk", "[", "Cm_", "]"}], "=", 
   RowBox[{
    FractionBox[
     RowBox[{
      RowBox[{"Sqrt", "[", 
       RowBox[{"1", "-", 
        RowBox[{
         FractionBox["3", "2"], "Cm"}]}], "]"}], "-", "1"}], 
     RowBox[{"xm", " ", 
      RowBox[{
       RowBox[{"Sinc", "'"}], "[", "xm", "]"}], 
      RowBox[{"Sqrt", "[", "As", "]"}]}]], "/.", 
    RowBox[{"{", 
     RowBox[{"xm", "->", "2.74"}], "}"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"dnu2dCm", "[", "Cm_", "]"}], "=", 
   RowBox[{
    RowBox[{
     RowBox[{"nu2inCk", "'"}], "[", "Cm", "]"}], "//", "Simplify"}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{4.0039532106435843`*^9, 4.0039532310911503`*^9}, {
  4.0040541178997717`*^9, 4.0040541251072893`*^9}},
