             RowBox[{"\[Gamma]n", "[", "s2s", "]"}], " ", "\[Nu]"}]}], ")"}], 
          "2"], 
         RowBox[{"1", "-", 
          SuperscriptBox[
           RowBox[{"\[Gamma]n", "[", "s2s", "]"}], "2"]}]]}], ")"}]}], 
     "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
