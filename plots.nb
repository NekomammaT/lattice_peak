Cell[CellGroupData[{

Cell["mono", "Subsection",
 CellChangeTimes->{{4.00354860095788*^9, 4.003548601158372*^9}, {
  4.003567920107387*^9, 4.0035679240752487`*^9}, {4.003570031101708*^9, 
  4.003570031101754*^9}, {4.003923966978139*^9, 4.0039239669781733`*^9}, {
  4.003951845611663*^9, 
  4.0039518458442917`*^9}},ExpressionUUID->"9c4f313b-fc47-4b44-ba1c-\
4571653f4a75"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"\[Sigma]1", "=", 
   FractionBox[
    RowBox[{"2", "\[Pi]", " ", "npeak"}], "NL"]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Sigma]2", "=", 
   SuperscriptBox["\[Sigma]1", "2"]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Sigma]3", "=", 
   SuperscriptBox["\[Sigma]1", "3"]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Sigma]4", "=", 
   SuperscriptBox["\[Sigma]1", "4"]}], ";"}]}], "Input",
 CellChangeTimes->{{4.002154289627619*^9, 4.0021542979920883`*^9}, {
  4.002160531705282*^9, 4.00216053181039*^9}, {4.0039518983306007`*^9, 
  4.003951928143676*^9}},
 CellLabel->
  "In[237]:=",ExpressionUUID->"f67cb3f3-0ef7-46fb-9ab0-485ba0bd2d0b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Nsim", "=", "100"}], ";"}]], "Input",
 CellChangeTimes->{{4.003550215480002*^9, 4.0035502176876497`*^9}},
 CellLabel->
  "In[241]:=",ExpressionUUID->"4457c778-f6a1-4a6d-a3f0-74068e8b5410"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Lpeak", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Import", "[", 
      RowBox[{"\"\<data/paper/mono/mono_Lpeak_256_16_\>\"", "<>", 
       RowBox[{"ToString", "[", "i", "]"}], "<>", "\"\<.csv\>\""}], "]"}], 
     ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "0", ",", 
       RowBox[{"Nsim", "-", "1"}]}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"nuP", "=", 
   RowBox[{
    RowBox[{"Lpeak", "[", 
     RowBox[{"[", 
      RowBox[{"All", ",", "All", ",", "4"}], "]"}], "]"}], "/", 
    "\[Sigma]2"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"k3P", "=", 
   RowBox[{
    RowBox[{"Lpeak", "[", 
     RowBox[{"[", 
      RowBox[{"All", ",", "All", ",", "5"}], "]"}], "]"}], 
    RowBox[{"Sqrt", "[", 
