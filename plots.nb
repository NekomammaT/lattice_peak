Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"nu2inCk", "[", "Cm_", "]"}], "=", 
   RowBox[{
    FractionBox[
     RowBox[{
      RowBox[{"Sqrt", "[", 
       RowBox[{"1", "-", 
        RowBox[{
         FractionBox["3", "2"], "Cm"}]}], "]"}], "-", "1"}], 
     RowBox[{"xm", " ", 
      RowBox[{
       RowBox[{"Sinc", "'"}], "[", "xm", "]"}], 
      RowBox[{"Sqrt", "[", "As", "]"}]}]], "/.", 
    RowBox[{"{", 
     RowBox[{"xm", "->", "2.74"}], "}"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"dnu2dCm", "[", "Cm_", "]"}], "=", 
   RowBox[{
    RowBox[{
     RowBox[{"nu2inCk", "'"}], "[", "Cm", "]"}], "//", "Simplify"}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{4.0039532106435843`*^9, 4.0039532310911503`*^9}, {
  4.0040541178997717`*^9, 4.0040541251072893`*^9}},
 CellLabel->
  "In[103]:=",ExpressionUUID->"6d5026ee-b3eb-45c9-be97-75e01cc60ecd"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"nCpt", "[", "Cm_", "]"}], "=", 
   RowBox[{
    RowBox[{"nnu2PT", "[", 
     RowBox[{"nu2inCk", "[", "Cm", "]"}], "]"}], 
    RowBox[{"Abs", "[", 
     RowBox[{"dnu2dCm", "[", "Cm", "]"}], "]"}]}]}], ";"}]], "Input",
 CellChangeTimes->{{4.003953265705154*^9, 4.0039532886459837`*^9}},
 CellLabel->
  "In[105]:=",ExpressionUUID->"6c7360fa-f6df-491d-8d1d-7e5292b2e80d"],

