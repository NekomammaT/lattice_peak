 RowBox[{
  RowBox[{
   RowBox[{"Cpk", "[", "x_", "]"}], "=", 
   RowBox[{
    RowBox[{
     FractionBox["2", "3"], 
     RowBox[{"(", 
      RowBox[{"1", "-", 
