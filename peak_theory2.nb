Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"MPBH", "[", 
    RowBox[{"nu2_", ",", "k3t_"}], "]"}], "=", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       SuperscriptBox[
        RowBox[{"xmint", "[", "k3t", "]"}], "2"], 
       SuperscriptBox["E", 
        RowBox[{"2", 
         FractionBox[
          RowBox[{"\[Sigma]n2", "[", 
           RowBox[{"1", ",", "s2s"}], "]"}], 
          RowBox[{"Sqrt", "[", 
           RowBox[{"\[Sigma]n2", "[", 
            RowBox[{"2", ",", "s2s"}], "]"}], "]"}]], " ", "nu2", " ", 
         RowBox[{"\[Zeta]x", "[", 
          RowBox[{
           RowBox[{"xmint", "[", "k3t", "]"}], ",", "k3t"}], "]"}]}]], 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Cm", "[", 
           RowBox[{"nu2", ",", "k3t", ",", "As"}], "]"}], "-", "Cth"}], ")"}],
         "\[Gamma]"]}], "/.", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"\[Gamma]", "->", 
         FractionBox["36", "100"]}], ",", 
        RowBox[{"Ag", "->", "As"}]}], 
       RowBox[{"(*", 
        RowBox[{",", 
         RowBox[{"Cth", "->", "0.533"}]}], "*)"}], "}"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"ks", ">", "0"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"dlnMdnu2", "[", 
    RowBox[{"nu2_", ",", "k3t_"}], "]"}], "=", 
