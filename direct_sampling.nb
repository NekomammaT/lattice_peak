Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", "x_", "]"}], "=", 
   RowBox[{
    RowBox[{
     FractionBox["1", "2"], "x", 
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox["x", "2"], "-", "3"}], ")"}], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"Erf", "[", 
        RowBox[{
         FractionBox["1", "2"], 
         RowBox[{"Sqrt", "[", 
          FractionBox["5", "2"], "]"}], "x"}], "]"}], "+", 
       RowBox[{"Erf", "[", 
        RowBox[{
         RowBox[{"Sqrt", "[", 
          FractionBox["5", "2"], "]"}], "x"}], "]"}]}], ")"}]}], "+", 
    RowBox[{
     RowBox[{"Sqrt", "[", 
      FractionBox["2", 
       RowBox[{"5", "\[Pi]"}]], "]"}], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          FractionBox["8", "5"], "+", 
          RowBox[{
           FractionBox["31", "4"], 
           SuperscriptBox["x", "2"]}]}], ")"}], 
        RowBox[{"Exp", "[", 
         RowBox[{
          FractionBox[
           RowBox[{"-", "5"}], "8"], 
          SuperscriptBox["x", "2"]}], "]"}]}], "+", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          FractionBox[
           RowBox[{"-", "8"}], "5"], "+", 
          RowBox[{
           FractionBox["1", "2"], 
           SuperscriptBox["x", "2"]}]}], ")"}], 
        RowBox[{"Exp", "[", 
         RowBox[{
          FractionBox[
           RowBox[{"-", "5"}], "2"], 
          SuperscriptBox["x", "2"]}], "]"}]}]}], ")"}]}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"nmu2PT", "[", "mu2_", "]"}], "=", 
   RowBox[{
    FractionBox[
     SuperscriptBox["kpeak", "3"], 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"6", "\[Pi]"}], ")"}], 
      RowBox[{"3", "/", "2"}]]], " ", 
    RowBox[{"f", "[", 
     FractionBox["mu2", "\[Sigma]2"], "]"}], 
    FractionBox["1", 
     RowBox[{"Sqrt", "[", 
      RowBox[{"2", "\[Pi]", " ", 
       SuperscriptBox["\[Sigma]2", "2"]}], "]"}]], 
    RowBox[{"Exp", "[", 
     FractionBox[
      RowBox[{"-", 
       SuperscriptBox["mu2", "2"]}], 
      RowBox[{"2", 
       SuperscriptBox["\[Sigma]2", "2"]}]], "]"}]}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.963881913511917*^9, 3.963881917896393*^9}, {
