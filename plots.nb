                FractionBox[
                 SuperscriptBox[
                  RowBox[{"Variance", "[", 
                   RowBox[{"#", "[", 
                    RowBox[{"[", 
                    RowBox[{"All", ",", "1"}], "]"}], "]"}], "]"}], "2"], 
                 RowBox[{
                  RowBox[{"2", 
                   RowBox[{"Length", "[", "#", "]"}]}], "-", "2"}]]}], "]"}], 
              "]"}], "-", "1"}], "]"}], ",", "0"}], "]"}], "&"}], "@", 
        RowBox[{"MCbinning", "[", 
