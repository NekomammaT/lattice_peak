          RowBox[{"3", ",", "s2s"}], "]"}]], "]"}], "3"], " ", "nu2", " ", 
      "k3t", " ", 
      RowBox[{"f", "[", 
       RowBox[{"nu2", " ", 
        SuperscriptBox["k3t", "2"]}], "]"}], 
      RowBox[{"P13", "[", 
       RowBox[{"nu2", ",", 
        RowBox[{"nu2", " ", 
         SuperscriptBox["k3t", "2"]}]}], "]"}]}], ",", 
     RowBox[{"{", 
