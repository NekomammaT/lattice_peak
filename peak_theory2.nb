0b4f92792040"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", "x_", "]"}], "=", 
   RowBox[{
    RowBox[{
     FractionBox["1", "2"], "x", 
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox["x", "2"], "-", "3"}], ")"}], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"Erf", "[", 
        RowBox[{
         FractionBox["1", "2"], 
         RowBox[{"Sqrt", "[", 
          FractionBox["5", "2"], "]"}], "x"}], "]"}], "+", 
       RowBox[{"Erf", "[", 
        RowBox[{
         RowBox[{"Sqrt", "[", 
          FractionBox["5", "2"], "]"}], "x"}], "]"}]}], ")"}]}], "+", 
    RowBox[{
     RowBox[{"Sqrt", "[", 
      FractionBox["2", 
       RowBox[{"5", "\[Pi]"}]], "]"}], 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          FractionBox["8", "5"], "+", 
          RowBox[{
           FractionBox["31", "4"], 
           SuperscriptBox["x", "2"]}]}], ")"}], 
        RowBox[{"Exp", "[", 
         RowBox[{
          FractionBox[
           RowBox[{"-", "5"}], "8"], 
          SuperscriptBox["x", "2"]}], "]"}]}], "+", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          FractionBox[
           RowBox[{"-", "8"}], "5"], "+", 
          RowBox[{
           FractionBox["1", "2"], 
           SuperscriptBox["x", "2"]}]}], ")"}], 
        RowBox[{"Exp", "[", 
         RowBox[{
          FractionBox[
           RowBox[{"-", "5"}], "2"], 
          SuperscriptBox["x", "2"]}], "]"}]}]}], ")"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"nnu2PT", "[", 
    RowBox[{"nu2_", ",", "ks_"}], "]"}], "=", 
   RowBox[{
    FractionBox[
     SuperscriptBox["ks", "3"], 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"6", "\[Pi]"}], ")"}], 
      RowBox[{"3", "/", "2"}]]], " ", 
    RowBox[{"f", "[", "nu2", "]"}], 
    FractionBox["1", 
     RowBox[{"Sqrt", "[", 
      RowBox[{"2", "\[Pi]"}], "]"}]], 
    RowBox[{"Exp", "[", 
     FractionBox[
      RowBox[{"-", 
       SuperscriptBox["nu2", "2"]}], "2"], "]"}]}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.947330614734089*^9, 3.9473306406978807`*^9}, {
   3.94733068962934*^9, 3.947330717741521*^9}, {3.9473308229785347`*^9, 
   3.9473308474110117`*^9}, {3.9473308791282673`*^9, 3.947331023943302*^9}, {
   3.947331142056903*^9, 3.9473312032373257`*^9}, {3.947331239284193*^9, 
