Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"MPBH", "[", 
    RowBox[{"nu2_", ",", "k3t_"}], "]"}], "=", 
   RowBox[{"Simplify", "[", 
    RowBox[{
