 RowBox[{
  RowBox[{
   RowBox[{"WRTH", "[", "z_", "]"}], "=", 
   RowBox[{"3", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"Sin", "[", "z", "]"}], "-", 
       RowBox[{"z", " ", 
