Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"nu2thint", "[", "k3t_", "]"}], "=", 
   RowBox[{
    RowBox[{"Interpolation", "[", "nu2thList", "]"}], "[", "k3t", "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.992390266390792*^9, 3.992390277957739*^9}},
 CellLabel->"In[74]:=",ExpressionUUID->"3517f226-1f0a-49bf-803d-0cd7e2479cce"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"MPBH", "[", 
    RowBox[{"nu2_", ",", "k3t_"}], "]"}], "=", 
   RowBox[{
    RowBox[{
     SuperscriptBox[
      RowBox[{"xmint", "[", "k3t", "]"}], "2"], 
     SuperscriptBox["E", 
      RowBox[{"2", 
       RowBox[{"Sqrt", "[", "As", "]"}], " ", "nu2", " ", 
       RowBox[{"\[Zeta]x", "[", 
        RowBox[{
         RowBox[{"xmint", "[", "k3t", "]"}], ",", "k3t"}], "]"}]}]], 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Cm", "[", 
         RowBox[{"nu2", ",", "k3t"}], "]"}], "-", "Cth"}], ")"}], 
      "\[Gamma]"]}], "/.", 
    RowBox[{"{", 
     RowBox[{"\[Gamma]", "->", 
      FractionBox["36", "100"]}], 
     RowBox[{"(*", 
      RowBox[{",", 
       RowBox[{"Cth", "->", "0.533"}]}], "*)"}], "}"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"dlnMdnu2", "[", 
    RowBox[{"nu2_", ",", "k3t_"}], "]"}], "=", 
   RowBox[{
    SubscriptBox["\[PartialD]", "nu2"], 
    RowBox[{"Log", "[", 
     RowBox[{"MPBH", "[", 
      RowBox[{"nu2", ",", "k3t"}], "]"}], "]"}]}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.9923889918135357`*^9, 3.9923890397219763`*^9}, {
  3.992454837814168*^9, 3.992454863359489*^9}, {3.992454903617217*^9, 
