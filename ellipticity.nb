            RowBox[{"\[Gamma]", " ", "nu"}]}], ")"}], "2"], 
         RowBox[{"1", "-", 
          SuperscriptBox["\[Gamma]", "2"]}]]}], ")"}]}], "]"}]}]}], 
  ";"}]], "Input",
