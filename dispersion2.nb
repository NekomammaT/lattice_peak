  RowBox[{"\[Psi]nrr", "[", 
   RowBox[{"x_", ",", "n_", ",", "s2_"}], "]"}], ":=", 
  RowBox[{"NIntegrate", "[", 
   RowBox[{
    RowBox[{
     RowBox[{
      FractionBox[
       SuperscriptBox["ks", 
        RowBox[{"2", "n"}]], 
