Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"nu2inMk3tList", "=", 
    RowBox[{"Flatten", "[", 
     RowBox[{
      RowBox[{"ParallelTable", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"10", "^", "lnM"}], ",", 
          RowBox[{"10", "^", "lnk3t"}], ",", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"nu2thint", "[", 
              RowBox[{"10", "^", "lnk3t"}], "]"}], "+", 
             RowBox[{"10", "^", "lndnu2"}]}], "/.", 
            RowBox[{"FindRoot", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"MPBH", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"nu2thint", "[", 
                   RowBox[{"10", "^", "lnk3t"}], "]"}], "+", 
