 RowBox[{
  RowBox[{"Cth", "=", 
   RowBox[{"533", "/", "1000"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"MPBH", "[", 
     RowBox[{"xm_", ",", "zetam_", ",", "Cm_"}], "]"}], "=", 
    RowBox[{
     RowBox[{
      SuperscriptBox["xm", "2"], 
      SuperscriptBox["E", 
       RowBox[{"2", "zetam"}]], 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"Cm", "-", "Cth"}], ")"}], "\[Gamma]"]}], "/.", 
     RowBox[{"{", 
      RowBox[{"\[Gamma]", "->", "0.36"}], "}"}]}]}], ";"}], 
  RowBox[{"(*", 
